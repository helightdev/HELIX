<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HelixWeaveGenerator</AssemblyName>
    <RootNamespace>Helix.Weave</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The host, plus the lowered mixins. Compiled into one analyzer assembly, like Hix's. -->
  <ItemGroup>
    <Compile Include="../Helix.Weave/**/*.cs" Exclude="../Helix.Weave/bin/**;../Helix.Weave/obj/**" />

  </ItemGroup>

  <!-- Opt-in: `dotnet build -p:Lower=true` regenerates gen/ from the mixin project. -->
  <Target Name="LowerMixins" BeforeTargets="BeforeCompile" Condition="'$(Lower)' == 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../Helix.Weave.Lower&quot; -- &quot;$(MSBuildThisFileDirectory)../Helix.Weave.Mixins&quot; &quot;$(MSBuildThisFileDirectory)gen&quot;"
          StandardOutputImportance="low" />
  </Target>
</Project>
