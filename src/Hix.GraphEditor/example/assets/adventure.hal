%graphPosition(x=1140, y=220)
--- Quest &quest
title = "Lanterns of the old watchtower"
difficulty = hard
// state is omitted: its default is available.
giver = ref(warden)
destination = ref(watchtower)
objectives = ref(objectives)
rewards = ref(rewards)
levels = ref(levels)
tags = ref(tags)
// Explicit null is different from the omitted optional designerNote field.
subtitle = null

%graphPosition(x=0, y=-220)
--- QuestNpc &warden
name = "Warden Elara"
faction = rangers
home = ref(watchtower)

%graphPosition(x=0, y=160)
--- QuestLocation &watchtower
name = "Old watchtower"
x = 42
y = -18

%graphPosition(x=760, y=0)
--- QuestObjectives &objectives
[ref(briefing), ref(lanterns), ref(survey)]

%graphPosition(x=380, y=-240)
--- TalkObjective &briefing
title = "Speak with the warden"
// Shared NPC: editing this supplier also updates the quest giver.
speaker = ref(warden)
dialogue = "Ask why the tower has gone dark."

%graphPosition(x=380, y=40)
--- CollectObjective &lanterns
title = "Find replacement lanterns"
item = brass-lantern
count = 3

%graphPosition(x=380, y=320)
--- ExploreObjective &survey
title = "Survey the tower roof"
// Shared location: also used by the NPC and quest root.
destination = ref(watchtower)
radius = 25
optional = true

%graphPosition(x=760, y=560)
--- QuestRewards &rewards
[ref(payment), ref(compass)]

%graphPosition(x=380, y=640)
--- CurrencyReward &payment
amount = 150
// currency defaults to gold.

%graphPosition(x=380, y=900)
--- EquipmentReward &compass
item = pathfinder-compass
rarity = rare
// quantity defaults to one.

%graphPosition(x=760, y=800)
--- QuestLevelRange &levels
[5, 12]

%graphPosition(x=760, y=1040)
--- QuestTags &tags
[exploration, dialogue, optional-objective]
