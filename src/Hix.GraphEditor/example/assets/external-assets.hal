%uid("example.external-assets")
%graphPosition(x=400, y=0)
--- table &catalog
// The primary section can have a name; omitting the section still selects it.
quest = asset(path("adventure.hal"))
location = asset(uid("example.watchtower"))
// Select a non-primary section explicitly.
warden = asset(path("adventure.hal"), "warden")
// Local section references retain their original meaning.
note = ref(note)

%graphPosition(x=0, y=220)
--- table &note
text = "Foreign assets are built and cached as full values."
