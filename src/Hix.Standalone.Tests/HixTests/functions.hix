%test
func primitivePatternsAndConversions {
  assert(eq(cast(12, string), <12>))
  assert(eq(cast(true, string), <true>))
  assert(eq(cast(<2.5>, number), 2.5))
  assert(eq(cast(true, number), 1))
  assert(eq(cast(null, number), 0))
  assert(eq(cast(1, bool), true))
  assert(eq(cast(<>, bool), false))
  assert(is(<text>, string))
  assert(is(12, number))
  assert(eq(pattern(@[1]), tuple))
  assert(eq(new(string), <>))
  assert(eq(new(tuple), @[]))
  assert(eq(new(table), @{}))
  assert(eq(cast(4, string), <4>))
  assert(eq(cast(<value>, tuple), @[<value>]))
  assert(eq(cast(@{a=1, b=2}, tuple), @[@[<a>, 1], @[<b>, 2]]))
  assert(eq(cast(@[@[<a>, 1], @[<b>, 2]], table), @{a=1, b=2}))
  assert(eq(pattern(<value>), string))
  assert(eq(pattern(string), pattern))
}

%test
func logicAndPresence {
  assert(eq(not(false), true))
  assert(not(null))
  assert(not(missing))
  assert(and(true, 1, <yes>))
  assert(not(and(true, 0, <yes>)))
  assert(or(false, null, true))
  assert(not(or(false, null, missing)))
  assert(eq(neq(1, 2), true))
  assert(eq(exists(missing), false))
  assert(eq(exists(null), false))
  assert(eq(exists(0), true))
  assert(eq(if(<value>, string, <fallback>), <value>))
  assert(eq(if(12, string, <fallback>), <fallback>))
  assert(eq(ifNot(1, string, 2), 1))
  assert(eq(ifNot(<value>, string, <fallback>), <fallback>))
  assert(eq(eq(@[1, @{name=<Ada>}], @[1, @{name=<Ada>}]), true))
  assert(neq(@{name=<Ada>}, @{name=<Grace>}))
}

%test
%testcase(@[1.6], 2)
%testcase(@[-1.6], -2)
func rounded(number value) -> number => round($value);

%test
func numericFunctions {
  assert(eq(floor(1.9), 1))
  assert(eq(ceil(1.1), 2))
  assert(eq(abs(-3), 3))
  assert(eq(sqrt(9), 3))
  assert(eq(log(8, 2), 3))
  assert(eq(min(2, 5), 2))
  assert(eq(max(2, 5), 5))
  assert(eq(pow(2, 3), 8))
  assert(eq(minus(7, 2), 5))
  assert(eq(plus(7, 2), 9))
  assert(eq(mult(7, 2), 14))
  assert(eq(div(8, 2), 4))
  assert(eq(mod(8, 3), 2))
  assert(eq(clamp(12, 0, 10), 10))
  assert(isInt(3))
  assert(not(isInt(3.5)))
  assert(compare(2, <lt>, 3))
  assert(compare(3, <lte>, 3))
  assert(compare(3, <eq>, 3.0000000001))
  assert(compare(3, <neq>, 4))
  assert(compare(3, <gte>, 3))
}

%test
func numericFailuresAreCheckable {
  assert(is([sqrt(-1)?], error))
  assert(is([div(1, 0)?], error))
  assert(is([compare(1, <unknown>, 2)?], error))
}

%test
func stringFunctions {
  assert(eq(substring(<abcdef>, 1, 4), <bcd>))
  assert(eq(split(<a,b,c>, <,>), @[<a>, <b>, <c>]))
  assert(eq(split(<abc>, <,>), @[<abc>]))
  assert(startsWith(<abcdef>, <abc>))
  assert(endsWith(<abcdef>, <def>))
  assert(contains(<abcdef>, <cd>))
  assert(matches(<abc123>, <^\x5ba-z\x5d+\x5b0-9\x5d+$>))
  assert(eq(uppercase(<Abc>), <ABC>))
  assert(eq(lowercase(<AbC>), <abc>))
  assert(eq(trim(<  text  >), <text>))
  assert(eq(trimStart(<  text>), <text>))
  assert(eq(trimEnd(<text  >), <text>))
  assert(eq(replaceAll(<one two one>, <one>, <1>), <1 two 1>))
  assert(eq(replaceFirst(<one one>, <one>, <1>), <1 one>))
  assert(eq(replaceLast(<one one>, <one>, <1>), <one 1>))
  assert(eq(regexReplaceAll(<a1b2>, <\x5b0-9\x5d>, <x>), <axbx>))
  assert(eq(regexReplaceFirst(<a1b2>, <\x5b0-9\x5d>, <x>), <axb2>))
  assert(eq(replaceFirst(<abc>, <z>, <x>), <abc>))
  assert(eq(replaceLast(<abc>, <z>, <x>), <abc>))
  assert(eq(length(<åbc>), 3))
}

%test
func stringFailuresAreCheckable {
  assert(is([substring(<abc>, -1, 2)?], error))
  assert(is([substring(<abc>, 2, 1)?], error))
  assert(is([substring(<abc>, 0, 4)?], error))
  assert(is([replaceFirst(<abc>, <>, <x>)?], error))
  assert(is([replaceLast(<abc>, <>, <x>)?], error))
}

%test
%testcase(@[], @[2, 2, true, null, <fallback>, true, 0, @[1, 2, 3], @[1, 2],
  @{second=<two>, first=<one>}, @{first=<one>}, @[<second>, <first>], @[<two>, <one>],
  @[@[<second>, <two>], @[<first>, <one>]], <a,b>, <second=two;first=one>])
func collectionFunctions() -> tuple {
  local items = @[<a>, @[<b>, <c>]]
  local record = @{second=null, first=<one>}
  local replaced = put($record, <second>, <two>)
  return(@[
    length($items), length(cast($items#1, tuple)), has($record, <second>),
    get($record, <second>, <fallback>), get($record, <missing>, <fallback>),
    contains($items, <a>), indexOf($items, <a>), push(@[1, 2], 3), pop(@[1, 2, 3]),
    $replaced, remove($replaced, <second>), keys($replaced), values($replaced), entries($replaced),
    join(@[<a>, <b>], <,>), join($replaced, <=>, <;>)
  ])
}

%test
func tupleAndTableLookupEdges {
  assert(has(@[<zero>, null], 1))
  assert(not(has(@[<zero>], -1)))
  assert(not(has(@[<zero>], 1.5)))
  assert(eq(get(@[<zero>], 5), missing))
  assert(eq(get(@[<zero>], 5, <fallback>), <fallback>))
  assert(eq(indexOf(@[1, 2, 1], 1), 0))
  assert(eq(indexOf(@[1, 2], 3), -1))
  assert(eq(pop(@[]), @[]))
  assert(eq(put(@{a=1}, @{a=2, b=3}), @{a=2, b=3}))
  assert(contains(@{a=1, b=2}, 2))
}

pure func describe { return(<value:[$0]>) }
pure func sum { return(plus($0, $1)) }
pure func positive { return(compare($0, <gt>, 0)) }

%test
func callbackFunctions {
  assert(eq(map(@[2, 3], describe), @[<value:2>, <value:3>]))
  assert(eq(where(@[-1, 2, 3], positive), @[2, 3]))
  assert(eq(reduce(@[2, 3], sum, 0), 5))
  assert(eq(any(@[], positive), false))
  assert(eq(all(@[], positive), true))
  assert(eq(map(@[<a>, <b>], func => <[$0]!>), @[<a!>, <b!>]))
  assert(eq(map(@[<a>, <b>], func { return(<[$0]?>) }), @[<a?>, <b?>]))
  assert(any(@[-2, -1, 3], positive))
  assert(not(all(@[-2, 1, 3], positive)))
  assert(all(@[1, 2, 3], positive))
}

pure func choose(string first, string second = [<default>]) -> string { return($second) }

%test
%testcase(@[], @[<default>, <named>])
func namedArgumentsAndDefaults() -> tuple => @[
  choose(first = <one>), choose(second = <named>, first = <one>)
];

pure func absentIsMissing(%optional string value) -> bool { return(eq($value, missing)) }
pure func nullable(string? value) -> bool { return(eq($value, null)) }

%test
func missingAndNullableParameters {
  assert(absentIsMissing())
  assert(nullable(null))
}

%test
func checkedErrors {
  local failure = [cast(<bad>, error)?]
  assert(is($failure, error))
  assert(not(exists($failure)))
  assert(eq(catch($failure) ?: <fallback>, <fallback>))
  assert(eq(catch($failure, func => <handled>), <handled>))
  assert(eq(catch(<fine>, func => cast(<unreachable>, error)), <fine>))
}

// Stdlib enum patterns are available to declarations, casts, and chained calls.
pure func compareWithOperator(number left, ComparisonOperator op, number right) -> bool {
  return(compare($left, $op, $right))
}
%test
func comparisonOperatorPattern {
  local op @= cast(<lt>, ComparisonOperator);
  assert(compareWithOperator(1, $op, 2))
  local left @= 3;
  assert($left:compare(cast(<gte>, ComparisonOperator), 3))
  assert(is([cast(<unknown>, ComparisonOperator)?], error))
}

%test
func patternsTypeCheckPatternsAndKeepSingletonsConstant {
  assert(is(string, pattern))
  assert(is(pattern, pattern))
  assert(is(any, pattern))
  assert(is(pattern(null), pattern))
  assert(not(is(null, pattern)))
  assert(not(is(missing, pattern)))
  assert(is(null, pattern(null)))
  assert(is(missing, pattern(missing)))
  assert(is(12, any))
  assert(eq(cast(string, pattern), string))
  assert(is(new(pattern), pattern))
}

type PositiveNumber = %min(1) number
%test
func predicatesAndConditionalValuesUseDeclaredPatterns {
  assert(is(2, PositiveNumber))
  assert(not(is(0, PositiveNumber)))
  assert(eq(if(2, PositiveNumber, 0), 2))
  assert(eq(if(0, PositiveNumber, 3), 3))
  assert(eq(ifNot(0, PositiveNumber, 3), 0))
  assert(eq(ifNot(2, PositiveNumber, 3), 3))
}
