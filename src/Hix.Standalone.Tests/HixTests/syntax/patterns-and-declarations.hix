type MaybeText = string?;
type TextOrNumber = string | number;
type Record = @{string name, number age = [18], %optional string note,};
type Pair = @[string left, %optional number right,];
type TextList = %many<string>;
type TextMap = %map<string,string>;
type Positive = %min<1> number;
type Exact = %const<fixed> string;
type Handler = delegate(string value,) -> string;
%tagged type Animal = @{string name};

pure inline func inlineIdentity(string value) -> string => $value;
pure noinline func noinlineIdentity(string value) -> string { return($value) }
pure func doIdentity(string value,) -> string do { return($value) }
pure func defaultIdentity(string value = [<default>],) -> string => $value;
pure func optionalIdentity(%optional string value) -> any => $value;
pure func nullableIdentity(string? value) -> bool => eq($value, null);
pure func unionIdentity(string | number value) -> any => $value;
pure func callbackIdentity(Handler callback, string value) -> string => call($callback, $value);
pure func namedPosition(string first, string second) -> string => <[$first]:[$1]:[param#second]>;

%test
%testcase(@[], <value>)
func inlineFunctionModifier -> string { return(inlineIdentity(<value>)) }

%test
%testcase(@[], <value>)
func noinlineFunctionModifier -> string { return(noinlineIdentity(<value>)) }

%test
%testcase(@[], <value>)
func doFunctionBody -> string { return(doIdentity(<value>,)) }

%test
%testcase(@[], <default>)
func defaultParameterWithTrailingComma -> string { return(defaultIdentity()) }

%test
%testcase(@[], missing)
func optionalParameterOmission -> any { return(optionalIdentity()) }

%test
%testcase(@[], true)
func nullableParameterValue -> bool { return(nullableIdentity(null)) }

%test
%testcase(@[<text>], <text>)
%testcase(@[2], 2)
func unionParameterValues(string | number value) -> any { return(unionIdentity($value)) }

%test
%testcase(@[], <Ada>)
func tablePatternPositionalConstruction -> string { local value = Record(<Ada>); return($value#name) }

%test
%testcase(@[], <Ada:18>)
func tablePatternNamedConstruction -> string {
  local value = Record(note = <ready>, name = <Ada>,)
  return(<[$value#name]:[$value#age]>)
}

%test
%testcase(@[], <left>)
func tuplePatternNamedConstruction -> string { local value = Pair(left = <left>); return($value#0) }

%test
%testcase(@[], <Animal>)
func taggedPatternConstruction -> string { return(get(Animal(name = <Milo>), <$type>)) }

%test
%testcase(@[], @[<a>, <b>])
func manyPatternValidation -> any { return(TextList(@[<a>, <b>])) }

%test
%testcase(@[], @{a=<b>})
func mapPatternValidation -> any { return(TextMap(@{a=<b>})) }

%test
%testcase(@[], 2)
func constrainedPatternValidation -> number { return(Positive(2)) }

%test
%testcase(@[], <fixed>)
func constantPatternValidation -> string { return(Exact(<fixed>)) }

%test
%testcase(@[], <VALUE>)
func delegateParameterWithArrowLambda -> string { return(callbackIdentity(func => uppercase($0), <value>)) }

%test
%testcase(@[], <VALUE>)
func delegateParameterWithBlockLambda -> string { return(callbackIdentity(func { return(uppercase($0)) }, <value>)) }

%test
%testcase(@[], <left:right:right>)
func namedPositionalAndExplicitParameterRoots -> string { return(namedPosition(<left>, <right>)) }

pure func <literal function name> -> string => <literal>;
pure func typedTuple(@[string first, number second] value) -> number => $value#1;
pure func typedTable(@{string name, %optional number age} value) -> string => $value#name;
pure func nestedCallback(Handler callback) -> Handler => $callback;

%test
%testcase(@[], <literal>)
func literalFunctionDeclarationName -> string { return(call(function(<literal function name>))) }

%test
%testcase(@[], 2)
func tuplePatternParameter -> number { return(typedTuple(@[<first>, 2])) }

%test
%testcase(@[], <Ada>)
func tablePatternParameter -> string { return(typedTable(@{name=<Ada>})) }

%test
%testcase(@[], <VALUE>)
func returnedDelegateValue -> string {
  local callback = nestedCallback(func => uppercase($0))
  return(call($callback, <value>))
}
