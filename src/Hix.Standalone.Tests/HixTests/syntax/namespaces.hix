%using<syntax.paths>
%using<syntax.paths><p>
%using<syntax>
%using<syntax><s>
---
meta syntax.note(string text) for function;
type syntax.Text = string;
pure func syntax.paths.join(string first, string second = <right>) -> syntax.Text => <[$first]:[$second]>;
pure func join(string first, string second = <right>) -> string => <fallback>;

%syntax.note<qualified metadata>
%test
%testcase(@[], <left:right>)
func qualifiedNamespaceCall -> string { return(syntax.paths.join(<left>)) }

%test
%testcase(@[], <left:right>)
func importedNamespaceCall -> string { return(join(<left>)) }

%test
%testcase(@[], <left:right>)
func aliasedNamespaceCall -> string { return(p.join(second = <right>, first = <left>)) }

%test
%testcase(@[], <left:right>)
func importedNamespaceChain -> string { local value = <left> return($value:join<right>) }

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceChain -> string { local value = <left> return($value:syntax.paths.join<right>) }

%test
%testcase(@[], <left:right>)
func aliasedNamespaceChain -> string { local value = <left> return($value:p.join<right>) }

%note<imported metadata>
%test
%testcase(@[], <left:right>)
func importedTypeAndMetadata -> Text { return(join(<left>)) }

%s.note<aliased metadata>
%test
%testcase(@[], <left:right>)
func aliasedTypeAndMetadata -> s.Text { return(p.join(<left>)) }

%test
%testcase(@[], <left:right>)
func importedFunctionReference -> string {
  local callable = [join]
  return(call($callable, <left>))
}

pure func syntax.paths.choice(number value, number other) -> string => <imported>;
pure func choice(string value) -> string => <fallback>;
pure func choice(number value, number other) -> string => <fallback>;

%test
%testcase(@[], <fallback>)
func unmatchedImportedOverloadFallsBack -> string { return(choice(<text>)) }

%test
%testcase(@[], <imported>)
func matchingImportedOverloadWins -> string { return(choice(1, 2)) }

// Calls at statement-block roots use the default lexer mode, without inline brackets.
%test
func qualifiedNamespaceInvocation {
  syntax.paths.join(<left>, <right>)
  syntax.paths.join<left><right>
  syntax.paths.join(second = <right>, first = <left>)
}

%test
func aliasedNamespaceInvocation {
  p.join(<left>, <right>)
  p.join<left><right>
  p.join(second = <right>, first = <left>)
}

%test
func importedNamespaceInvocation {
  join(<left>, <right>)
  join<left><right>
  join(second = <right>, first = <left>)
}

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceInvocationInitializer -> string {
  local result = syntax.paths.join(<left>, <right>)
  return($result)
}

%test
%testcase(@[], <left:right>)
func aliasedNamespaceInvocationInitializer -> string {
  local result = p.join(second = <right>, first = <left>)
  return($result)
}

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceInvocationWithValueTail -> string {
  local result = syntax.paths.join<left> [<right>]
  return($result)
}

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceInvocationWithContentTail -> string {
  local result = syntax.paths.join<left> @> right
  return($result)
}

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceExpressionInitializer -> string {
  local result @= syntax.paths.join(<left>, <right>);
  return($result)
}

%test
%testcase(@[], <joined left:right>)
func qualifiedNamespaceAngleInterpolation -> string {
  return(<joined [syntax.paths.join(<left>, <right>)]>)
}

%test
%testcase(@[], <joined left:right>)
func aliasedNamespaceAngleInterpolation -> string {
  return(<joined [p.join(second = <right>, first = <left>)]>)
}

%test
%testcase(@[], <joined left:right>)
func importedNamespaceAngleInterpolation -> string {
  return(<joined [join(<left>, <right>)]>)
}

%test
%testcase(@[], <joined left:right>)
func qualifiedNamespaceContentInterpolation -> string {
  local first = <left>
  local result @> joined {{$first:syntax.paths.join<right>}}
  return($result)
}

%test
%testcase(@[], <joined left:right>)
func aliasedNamespaceContentInterpolation -> string {
  local first = <left>
  local result @> joined {{$first:p.join(second = <right>)}}
  return($result)
}

%test
%testcase(@[], <joined left:right>)
func importedNamespaceContentInterpolation -> string {
  local first = <left>
  local result @> joined {{$first:join<right>}}
  return($result)
}

%test
%testcase(@[], <left:right>)
func qualifiedNamespaceDirectFunctionReference -> string {
  return(call(syntax.paths.join, <left>))
}

%test
%testcase(@[], <left:right>)
func aliasedNamespaceDirectFunctionReference -> string {
  return(call(p.join, <left>))
}
