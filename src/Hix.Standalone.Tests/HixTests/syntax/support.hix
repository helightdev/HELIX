func assertCompilationFails(string source, string diagnostic) -> null {
  local compilation = compile($source)
  assert(not(success($compilation)), <Compilation fails>)
  assert(compare(length(diagnostics($compilation)), <gt>, 0), <A diagnostic is present>)
  assert(contains(get(diagnostics($compilation), 0), $diagnostic), <Contains the expected diagnostic>)
}

func assertRejected(string source) -> null {
  local compilation = compile($source)
  assert(not(success($compilation)), <Compilation fails>)
  assert(compare(length(diagnostics($compilation)), <gt>, 0), <A diagnostic is present>)
  assert(eq(length(functions($compilation)), 0))
  assert(eq(length(instructions($compilation)), 0))
}
