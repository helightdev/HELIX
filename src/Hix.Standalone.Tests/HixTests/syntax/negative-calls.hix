%import<support.hix>
---

%test
func unknownNamedParameter {
  local source = "pure func pair(string first, string second) -> string => $first;\nfunc invalid { pair(first = <a>, unknown = <b>) }"
  assertCompilationFails($source, <no overload of 'pair'>)
}

%test
func missingRequiredNamedParameter {
  local source = "pure func pair(string first, string second) -> string => $first;\nfunc invalid { pair(second = <b>) }"
  assertCompilationFails($source, <no overload of 'pair'>)
}

%test
func positionalAndNamedDuplicateParameter {
  local source = "pure func pair(string first, string second) -> string => $first;\nfunc invalid { pair(<a>, first = <b>) }"
  assertCompilationFails($source, <no overload of 'pair'>)
}

%test
func tooManyPositionalParameters {
  local source = "pure func one(string value) -> string => $value;\nfunc invalid { one(<a>, <b>) }"
  assertCompilationFails($source, <no overload of 'one'>)
}

%test
func unknownFunctionCall {
  local source = "func invalid { unknownSyntaxFunction() }"
  assertRejected($source)
}

%test
func dynamicCallDoesNotAcceptNamedTargetArguments {
  local source = "pure func pair(string first, string second) -> string => $first;\nfunc invalid { call(pair, unknown = <b>) }"
  assertCompilationFails($source, <no overload of 'call'>)
}

%test
func doubleCommaInCall {
  local source = "func invalid { uppercase(<a>,,) }"
  assertRejected($source)
}

%test
func missingNamedArgumentValue {
  local source = "func invalid { uppercase(value = ) }"
  assertRejected($source)
}

%test
func unclosedCallParameterList {
  local source = "func invalid { uppercase(<a> }"
  assertRejected($source)
}


%test
func ordinaryCallsRejectUnknownSignatures {
  local source = "func target { return($0) } func main() -> any { return(target(1)) }"
  assertCompilationFails($source, <cannot bind signature>)
}

%test
func ordinaryCallsRejectUnknownFunctions {
  local source = "func main() -> any { return(doesNotExist(1)) }"
  assertCompilationFails($source, <cannot bind signature>)
}

%test
func ordinaryCallsRejectUncertainOverloads {
  local source = "pure func choose(string value) -> string => $value; pure func choose(number value) -> number => $value; func main(any value) -> any { return(choose($value)) }"
  assertCompilationFails($source, <ambiguous overload>)
}

%test
func ordinaryCallsRejectUnknownArity {
  local source = "pure func target(number value) -> number => $value; func main() -> any { return(target()) }"
  assertCompilationFails($source, <no overload of>)
}

%test
func castInvocationsAreRemoved {
  local source = "func main() -> number { return(number(<12>)) }"
  assertCompilationFails($source, <cannot bind signature>)
}

%test
func dynamicDispatchSyntaxIsRemoved {
  local source = "pure func target() -> number => 1; func main() -> any { return([target() @dynamic]) }"
  assertRejected($source)
}

%test
func runtimeKindTypeIsNotALanguagePattern {
  assertCompilationFails("func invalid(kind value) -> any { return($value) }", <unknown pattern 'kind'>)
  assertRejected("func invalid { emit(kind) }")
  assertRejected("func invalid { kind(1) }")
}

%test
func invalidExportAliasIsRejected {
  assertRejected("%alias<bad name> pure func original(string value) -> string => $value;")
}

%test
func duplicateExportAliasIsRejected {
  assertRejected("%alias<same> %alias<same> pure func original(string value) -> string => $value;")
}

%test
func nullableAsCannotChooseConcreteOverloads {
  assertRejected("pure func choose(number value) -> number => $value; pure func choose(null value) -> null => null; func invalid(any value) { choose(as($value, number)) }")
}
