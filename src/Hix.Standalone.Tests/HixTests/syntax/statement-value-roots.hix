trait type StatementNamed = @{string name};
type StatementUser = %trait<StatementNamed> @{number id};

func checkEmptyStatementRoot(tuple value) -> any {
  assert(eq($value, @[]))
}

%test
%testcase(@[], <Ada>)
func smartTraitStatementRoots() -> string {
  local user = StatementUser(id = 1, StatementNamed = StatementNamed(name = <Ada>))
  local component = $user:StatementNamed;
  $user:StatementNamed:eq(@{name = <Ada>}):assert()
  return($component#name)
}

%test
func inlineStatementRoots {
  []:checkEmptyStatementRoot
  @[ ]:checkEmptyStatementRoot
  [<Ada>]:eq(<Ada>):assert()
  @{name = <Ada>}:get<name>:eq(<Ada>):assert()
  42:eq(42):assert()
  "Ada":eq(<Ada>):assert()
  local values = [];
  $values:checkEmptyStatementRoot;
  $values = [];
  assert(eq($values, @[]))
}
