func assertCompilationFails(string file, string diagnostic) -> null {
  local compilation = compile(readFile($file))
  assert(!$compilation:success, <Compilation Failed>)
  assert(compare($compilation:diagnostics:length, <gt>, 0), <More than one diagnostic is present>)
  // This should be probably handled using a any match
  assert($compilation:diagnostics:get(0):contains($diagnostic), <Contains the correct diagnostic as first diagnostic>)
}

%test
func invalidCallsAreRejected {
  assertCompilationFails(<invalid-call.hix>, <no overload of 'replaceAll'>)
}

%test
func duplicateParametersAreRejected {
  assertCompilationFails(<duplicate-parameter.hix>, <duplicate signature field>)
}

%test
func invalidNamedArgumentOrderingIsRejected {
  assertCompilationFails(<named-argument-order.hix>, <no overload of 'pair'>)
}

%test
func duplicateNamedArgumentsAreRejected {
  assertCompilationFails(<duplicate-named-argument.hix>, <no overload of 'pair'>)
}

%test
func effectsInPureFunctionsAreRejected {
  assertCompilationFails(<pure-effect.hix>, <pure functions cannot perform>)
}

%test
func legacySignatureSyntaxIsRejected {
  assertCompilationFails(<legacy-signature.hix>, <>)
}

%test
func validFileStillRuns { assert(true) }
