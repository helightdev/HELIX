<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference ExcludeAssets="runtime" Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0"/>
        <PackageReference ExcludeAssets="runtime" Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0"/>
    </ItemGroup>

    <!--
      Keep the analyzer self-contained: Rider and other .NET hosts can reference
      Helix.MixinLanguage.csproj, while the source generator compiles the same
      implementation into its own assembly without a runtime library dependency.
    -->
    <ItemGroup>
        <Compile Include="..\..\..\MixinLanguage\**\*.cs"
                 Exclude="..\..\..\MixinLanguage\bin\**\*;..\..\..\MixinLanguage\obj\**\*;..\..\..\MixinLanguage\Environment\Default\**\*.cs">
            <Link>Shared\%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>

    <Target Name="CopyDll" AfterTargets="Build" Condition="'$(SkipCopyDll)' != 'true'">
        <Copy SourceFiles="$(TargetDir)HelixSourceGenerator.dll"
              DestinationFolder="$(ProjectDir)\..\..\..\HELIX\Assets\Plugins\HELIX\Runtime\Scripts"
              SkipUnchangedFiles="true"
        />
    </Target>


</Project>
