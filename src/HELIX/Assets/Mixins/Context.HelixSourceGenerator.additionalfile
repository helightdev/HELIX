%backend<Unity>
---
func RequireHandler() -> null do {
  when(![var#IsEventHandler:eq(true)]) {
    using @> System;
    emit<Class>
      @> [NonSerializedAttribute]
      @> protected readonly EventHandlerList eventHandlerList = EventHandlerList.Create();
      @> EventHandlerList IEventListener.HandlerList => eventHandlerList;
    inject(<$Dispose>, 1) @> eventHandlerList.UnregisterAll();
    emit<Implements> @> IEventListener
    var<IsEventHandler> @= true;
  }
}

mixin HELIX.Context.EventHandlerAttribute(number priority = [0]) {
  prelude expression {
    RequireHandler()
  }
  prelude expression {
    when(var#IsComponent:eq(true)) {
      inject(<$ConfigureManaged>, -90000) @> registration.RegisterHandlerBinding<{{target#0:type}}>({{$priority}})
    }
    when(target#0:is<IAsyncChainEvt>) {
      assert(target#0:argument)
      inject(<$Init>, 1) @> eventHandlerList.RegisterAsync<{{target#0:type}}>({{target:name}}, {{$priority}});
      return
    }
    when(target#0:is<Evt>, target#0:ref) {
      inject(<$Init>, 1) @> eventHandlerList.Register<{{target#0:type}}>({{target:name}}, {{$priority}});
      return
    }
    when(target#0:is<Evt>, target#0:argument) {
      inject(<$Init>, 1) @> eventHandlerList.Register<{{target#0:type}}>({{target:name}}, {{$priority}});
      return
    }
  }
}

mixin HELIX.Context.Tests.Fixtures.AlwaysEnabledAttribute {
  prelude expression {
    inject(<$ConfigureManaged>, 0) @> registration.Condition(context => true);
  }
}

mixin HELIX.Context.InjectAttribute(string? qualifier = [null], bool required = [true]) {
  func InjectList(string? qualifier) -> null do {
    using @> System.Collections.Generic;
    assert(target:type#0:class)
    inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new TypeKey(typeof({{target:type#0}}), {{$qualifier:csharpLiteral}}), false, true));
    inject(<$Init>, -1) @> {{target:name}} = managed.ResolveAll<{{target:type#0}}>({{$qualifier:csharpLiteral}}) as {{target:type}};
  }

  prelude expression {
    using @> HELIX.Context;
    when(target:type:is<System.Collections.IEnumerable>, ![target:type:is<string>], target:type#0:exists) {
      InjectList($qualifier)
      return
    }
    inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new TypeKey(typeof({{target:type}}), {{$qualifier:csharpLiteral}}), {{$required}}));
    when($required:eq(false)) {
      inject(<$Init>, -1) @> {{target:name}} = managed.ResolveOptional<{{target:type}}>({{$qualifier:csharpLiteral}});
      return
    }
    inject(<$Init>, -1) @> {{target:name}} = managed.Resolve<{{target:type}}>({{$qualifier:csharpLiteral}});
  }
}

mixin HELIX.Context.BindAttribute(symbol? type = [null], string? qualifier = [null], bool required = [true], bool proxied = [false]) {
  prelude expression {
    using @> HELIX.Context;
    local Value @= target:name;
    local Method = <PublishBind>
    local Guard = <>
    local Type @> typeof({{target:type:unwrap}})
    when($proxied:eq(true)) {
      $Value @> () => {{target:name}}
      $Method = <PublishProxyBind>
    }
    when($required:eq(false)) {
      $Guard @> if ({{target:name}} != null)
    }
    when(![$type:eq(null)]) {
      $Type @= $type;
    }
    inject(<$ConfigureManaged>, 0) @> registration.Publication({{$Type}}, {{$qualifier:csharpLiteral}}, {{$required}});
    inject(<$LoadManagedLate>, 0) @> {{$Guard}}context.{{$Method}}({{$Type}}, {{$qualifier:csharpLiteral}}, {{$Value}});
  }
}

mixin HELIX.Context.ResourceAttribute(number source, string? qualifier = [null], bool required = [true]) {
  func ResourceSingle(number source, string? qualifier, bool required) -> null
  do {
    local WireKey @> {{string:new<@>}}"{{target:type:unwrap}}|{{$source}}|{{$qualifier}}"
    assert(target:type:class)
    assert(target:type:is<UnityEngine.Object>)
    :Addressables {
      when($source:eq(2)) {
        inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new AddressableDependency<{{target:type}}>({{$qualifier:csharpLiteral}}, {{$WireKey}}, {{$required}}), {{$required}}));
        inject(<$Init>, -1) @> {{target:name}} = managed.ResolveOptional<{{target:type}}>({{$WireKey}});
        return
      }
    }
    :Resources {
      when($source:eq(3)) {
        inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new ResourceDependency<{{target:type}}>({{$qualifier:csharpLiteral}}, {{$WireKey}}, {{$required}}), {{$required}}));
        inject(<$Init>, -1) @> {{target:name}} = managed.ResolveOptional<{{target:type}}>({{$WireKey}});
        return
      }
    }
    fail @> No valid injection source found for the target type.
  }

  func ResourceList(number source, string? qualifier) -> null
  do {
    using @> System.Collections.Generic
    using @> System.Collections
    local WireKey @> {{string:new<@>}}"list|{{target:type#0:unwrap}}|{{$source}}|{{$qualifier}}"
    assert(target:type#0:class)
    assert(target:type#0:is<UnityEngine.Object>)
    :AddressableList {
      when($source:eq(2)) {
        inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new AddressableListDependency<{{target:type#0}}>({{$qualifier:csharpLiteral}}, {{$WireKey}}), true));
        inject(<$Init>, -1) @> {{target:name}} = managed.Resolve<List<{{target:type#0}}>>({{$WireKey}}) as {{target:type}};
        return
      }
    }
    :ResourceList {
      when($source:eq(3)) {
        inject(<$ConfigureManaged>, 0) @> registration.Dependency(new ComponentDependency(new ResourceListDependency<{{target:type#0}}>({{$qualifier:csharpLiteral}}, {{$WireKey}}), true));
        inject(<$Init>, -1) @> {{target:name}} = managed.Resolve<List<{{target:type#0}}>>({{$WireKey}}) as {{target:type}};
        return
      }
    }
    fail @> No valid injection source found for the collected target type.
  }

  prelude expression {
    when(target:type:is<System.Collections.IEnumerable>, ![target:type:is<string>], target:type#0:exists) {
      ResourceList($source, $qualifier)
      return
    }
    ResourceSingle($source, $qualifier, $required)
    return
  }
}

mixin HELIX.Context.AutoDisposeAttribute {
  prelude expression {
    using @> HELIX.Context
    inject(<$Dispose>, 1) @> AutoDisposeMethods.DisposeDisposable(ref {{target:name}})
  }
}

mixin HELIX.Context.ManagedAttribute(symbol? scope = [null], bool optional = [false], number order = [0], number phase = [0]) {
  prelude expression {
    defineTarget<$ConfigureManaged> @> ^*~HELIX.Context.RegistrationConfigurator
    defineTarget<$LoadManaged> @> ^LoadManaged:HELIX.Context.ManagedLoadMethod
    defineTarget<$LoadManagedLate> @> ^LoadManagedLate:HELIX.Context.ManagedLoadMethod
    defineTarget<$UnloadManaged> @> ^UnloadManaged:HELIX.Context.ManagedUnloadMethod
    defineTarget<$Init> @> ^LoadManaged:HELIX.Context.ManagedLoadMethod
    defineTarget<$Dispose> @> $UnloadManaged
    var<IsComponent> @= true;
  }
  prelude expression {
    using @> HELIX.Context;
    using @> UnityEngine;
    inject(<$ConfigureManaged>, -100000) @> registration.name = "{{this:name}}";
    inject(<$ConfigureManaged>, -100000) @> registration.optional = {{$optional}};
    inject(<$ConfigureManaged>, -100000) @> registration.phase = {{$phase}};
    inject(<$ConfigureManaged>, -100000) @> registration.order = {{$order}};
    emit<Implements> @> IManaged
    emit<Class> @> public RuntimeManagedData managed { get; } = new();
    when($scope:eq(null)) {
      goto Activator
    }
    {
      inject(<$ConfigureManaged>, -100000) @> registration.scope = {{$scope}};
    }
    :Activator
    when(this:is<MonoBehaviour>) {
      inject(<$ConfigureManaged>, -100000) @> registration.activator = DefaultComponentActivators.MonoBehaviour<{{this:type}}>();
      goto End
    }
    {
      inject(<$ConfigureManaged>, -100000) @> registration.activator = DefaultComponentActivators.PlainObject<{{this:type}}>();
    }
    :End
  }
}

mixin HELIX.Context.TickerAttribute(any time = [<tick>], string target = [<Update>],
  string? condition = [null], number order = [10]) {
  prelude expression {
    using @> HELIX.Context;
    local Time = <-0f>
    $Time @= $time:floatTime;
    local TickerField @> _{{target:name}}Ticker
    when($Time:matches<^-.*>) {
      $Time @= $Time:regexReplaceAll<-|f><>;
      emit<Class> @> private FrameCountTicker {{$TickerField}} = new({{$Time}});
      goto HookCaller
    }
    {
      emit<Class> @> private FrameTimeTicker {{$TickerField}} = new({{$Time}});
    }
    :HookCaller {
      local TickerCondition @> {{$TickerField}}.Tick()
    }
    when(![$condition:eq(null)]) {
      $TickerCondition @> {{$condition}} && {{$TickerCondition}}
    }
    when(var#IsComponent:eq(true)) {
      $TickerCondition @> managed.IsActive && {{$TickerCondition}}
    }
    local InvokeTicker @> {{target:name}}();
    when(target:async) {
      assert(target:is<Cysharp.Threading.Tasks.UniTask>)
      using @> Cysharp.Threading.Tasks;
      local AsyncProxyName @> _{{target:name}}AsyncProxy
      emit<Class>
        @> private async UniTaskVoid {{$AsyncProxyName}}() {
        @>   try {
        @>     {{$TickerField}}.running = true;
        @>     await {{$InvokeTicker}}
        @>   } finally { {{$TickerField}}.running = false; }
        @> }
      $InvokeTicker @> {{$AsyncProxyName}}().Forget();
    }
    inject($target, $order) @> if ({{$TickerCondition}}) {{$InvokeTicker}}
  }
}

// Module discovery is generated from compilation symbols, without runtime reflection.
func ModuleComponentRegistration(symbol value) -> string {
  when(or(!class($value), generic($value), !accessible($value))) { return(<>) }
  local ns = namespace($value)
  when(var#ModuleFilter:exists, !eq(var#ModuleFilter, <>),
       !eq($ns, var#ModuleFilter), !startsWith($ns, <[var#ModuleFilter].>)) { return(<>) }
  local code @> registrations.Register(typeof({{$value}}), {{$value}}.RegistrationConfigurator);
  return($code)
}

pure func ModuleImportRegistration -> string {
  local code @> global::{{param}}.Instance.Discover(registrations);
  return($code)
}

func ConfigureModule(string? filter, any importedModules) -> null do {
  when(generic(this)) { return }
  var<ModuleFilter> @= $filter;
  local resolvedImports @= $importedModules;
  when(!exists($resolvedImports)) { $resolvedImports = @[] }
  local importCode = join(map($resolvedImports, ModuleImportRegistration), <>)
  local registrations = join(map(collectAnnotatedTypes<HELIX.Context.ManagedAttribute>, ModuleComponentRegistration), <>)
  emit<Implements> @> global::HELIX.Context.IHelixModule
  emit<Class>
    @> public static readonly {{this:type}} Instance = new {{this:type}}();
    @> public void Discover(global::HELIX.Context.ManagedRegistrations registrations) {
    @> {{$importCode}}
    @> {{$registrations}}
    @> }
}

mixin HELIX.Context.HelixModuleAttribute(string? name = [null], string? filter = [null], any import = [null]) {
  prelude expression { ConfigureModule($filter, $import) }
}

mixin HELIX.Context.HelixApplicationAttribute(string? name = [null], string? filter = [null], any import = [null]) {
  prelude expression {
    ConfigureModule($filter, $import)
    when(generic(this)) { return }
    emit<Class>
      @> public static global::HELIX.Context.ManagedRegistrations Discover() {
      @> var registrations = new global::HELIX.Context.ManagedRegistrations();
      @> Instance.Discover(registrations);
      @> return registrations;
      @> }
  }
}
