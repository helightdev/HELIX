mixin HELIX.Context.TickerAttribute {
  prelude expression {
    using @> HELIX.Context;
    local Time = <-0f>
    when(attr#time:exists) {
      local Time @= attr#time:floatTime;
    }
    local TickerField @> _{{target:name}}Ticker
    when(local#Time:matches<^-.*>) {
      local Time @= local#Time:regexReplaceAll<-|f><>;
      emit<Class> @> private FrameCountTicker {{local#TickerField}} = new({{local#Time}});
      goto HookCaller
    }
    {
      emit<Class> @> private FrameTimeTicker {{local#TickerField}} = new({{local#Time}});
    }
    :HookCaller {
      local TickerCondition @> {{local#TickerField}}.Tick()
    }
    when(![attr#condition:unwrap:eq(null)]) {
      local TickerCondition @> {{attr#condition:unwrap}} && {{local#TickerCondition}}
    }
    when(var#IsComponent:eq(true)) {
      local TickerCondition @> managed.IsActive && {{local#TickerCondition}}
    }
    local InvokeTicker @> {{target:name}}();
    when(target:async) {
      assert(target:is<Cysharp.Threading.Tasks.UniTask>)
      using @> Cysharp.Threading.Tasks;
      local AsyncProxyName @> _{{target:name}}AsyncProxy
      emit<Class>
        @> private async UniTaskVoid {{local#AsyncProxyName}}() {
        @>   try {
        @>     {{local#TickerField}}.running = true;
        @>     await {{local#InvokeTicker}}
        @>   } finally { {{local#TickerField}}.running = false; }
        @> }
      local InvokeTicker @> {{local#AsyncProxyName}}().Forget();
    }
    inject(attr#target:unwrap, attr#order:number) @> if ({{local#TickerCondition}}) {{local#InvokeTicker}}
  }
}

// Module discovery is generated from compilation symbols, without runtime reflection.
func ModuleComponentRegistration sig symbol -> string {
  when(or(!class(param), generic(param), !accessible(param))) { return(<>) }
  local ns = namespace(param)
  when(var#ModuleFilter:exists, !eq(var#ModuleFilter, <>),
       !eq(local#ns, var#ModuleFilter), !startsWith(local#ns, <[var#ModuleFilter].>)) { return(<>) }
  local code @> registrations.Register(typeof({{param}}), {{param}}.RegistrationConfigurator);
  return(local#code)
}

pure func ModuleImportRegistration sig any -> string {
  local code @> global::{{param}}.Instance.Discover(registrations);
  return(local#code)
}

func ConfigureModule() -> null do {
  when(generic(this)) { return }
  var ModuleFilter = unwrap(attr#filter)
  local imports = unwrap(attr#import)
  when(!exists(local#imports)) { local imports = @[] }
  local importCode = join(map(local#imports, ModuleImportRegistration), <>)
  local registrations = join(map(collectAnnotatedTypes<HELIX.Context.ManagedAttribute>, ModuleComponentRegistration), <>)
  emit<Implements> @> global::HELIX.Context.IHelixModule
  emit<Class>
    @> public static readonly {{this:type}} Instance = new {{this:type}}();
    @> public void Discover(global::HELIX.Context.ManagedRegistrations registrations) {
    @> {{local#importCode}}
    @> {{local#registrations}}
    @> }
}

mixin HELIX.Context.HelixModuleAttribute {
  prelude expression { ConfigureModule() }
}

mixin HELIX.Context.HelixApplicationAttribute {
