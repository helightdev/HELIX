mixin HELIX.Context.TickerAttribute {
  prelude expression {
    using @> HELIX.Context;
    local Time = <-0f>
    when(attr#time:exists) {
      local Time @= attr#time:floatTime;
    }
    local TickerField @> _{{target:name}}Ticker
    when(local#Time:matches<^-.*>) {
      local Time @= local#Time:regexReplaceAll<-|f><>;
      emit<Class> @> private FrameCountTicker {{local#TickerField}} = new({{local#Time}});
      goto HookCaller
    }
    {
      emit<Class> @> private FrameTimeTicker {{local#TickerField}} = new({{local#Time}});
    }
    :HookCaller {
      local TickerCondition @> {{local#TickerField}}.Tick()
    }
    when(![attr#condition:unwrap:eq(null)]) {
      local TickerCondition @> {{attr#condition:unwrap}} && {{local#TickerCondition}}
    }
    when(var#IsComponent:eq(true)) {
      local TickerCondition @> managed.IsActive && {{local#TickerCondition}}
    }
    local InvokeTicker @> {{target:name}}();
    when(target:async) {
      assert(target:is<Cysharp.Threading.Tasks.UniTask>)
      using @> Cysharp.Threading.Tasks;
      local AsyncProxyName @> _{{target:name}}AsyncProxy
      emit<Class>
        @> private async UniTaskVoid {{local#AsyncProxyName}}() {
        @>   try {
        @>     {{local#TickerField}}.running = true;
        @>     await {{local#InvokeTicker}}
        @>   } finally { {{local#TickerField}}.running = false; }
        @> }
      local InvokeTicker @> {{local#AsyncProxyName}}().Forget();
    }
    inject(attr#target:unwrap, attr#order:number) @> if ({{local#TickerCondition}}) {{local#InvokeTicker}}
  }
}
