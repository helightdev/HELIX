mixin HELIX.OdinSerializableAttribute {
  expression {
    emit<Implements> @> ISerializationCallbackReceiver
    emit<Implements> @> ISupportsPrefabSerialization
    emit<Annotation> @> ShowOdinSerializedPropertiesInInspector
    using @> UnityEngine;
    using @> Sirenix.Serialization;
    using @> Sirenix.OdinInspector;
    emit<Class> @> [SerializeField, HideInInspector]
    emit<Class> @> private SerializationData serializationData;
    emit<Class> @> SerializationData ISupportsPrefabSerialization.SerializationData { get { return this.serializationData; } set { this.serializationData = value; } }
    emit<Class> @> void ISerializationCallbackReceiver.OnAfterDeserialize() { UnitySerializationUtility.DeserializeUnityObject(this, ref this.serializationData); }
    emit<Class> @> void ISerializationCallbackReceiver.OnBeforeSerialize() { UnitySerializationUtility.SerializeUnityObject(this, ref this.serializationData); }
  }
}

