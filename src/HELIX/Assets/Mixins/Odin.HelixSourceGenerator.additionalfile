mixin HELIX.OdinSerializableAttribute {
  expression {
    emit<Implements> @> ISerializationCallbackReceiver
    emit<Implements> @> ISupportsPrefabSerialization
    emit<Annotation> @> ShowOdinSerializedPropertiesInInspector
    using @> UnityEngine;
    using @> Sirenix.Serialization;
    using @> Sirenix.OdinInspector;
    emit<Class> 
      @> [SerializeField, HideInInspector]
      @> private SerializationData serializationData;
      @> SerializationData ISupportsPrefabSerialization.SerializationData 
        @+ { get { return this.serializationData; } set { this.serializationData = value; } }
      @> void ISerializationCallbackReceiver.OnAfterDeserialize() 
        @+ { UnitySerializationUtility.DeserializeUnityObject(this, ref this.serializationData); }
      @> void ISerializationCallbackReceiver.OnBeforeSerialize() 
        @+ { UnitySerializationUtility.SerializeUnityObject(this, ref this.serializationData); }
  }
}

