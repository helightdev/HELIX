func GenerateBoundaryElement() -> null {
  local ComposeCalls = <>
  local ComposeArgs = <>
  RequireCompositionTypeId()
  RequireCompositionId()
  DeclareCompanion
    @> public static readonly CompositionId fullId = new() {
    @>   composition = compositionId,
    @>   type = typeId,
    @>   local = LocalId.Initial
    @> };
  when(this#Props:exists) {
    local PropsModel @= this#Props:DeriveFields;
    when(![local#PropsModel:length:eq(0)]) {
      local PropsParameters @= local#PropsModel:map(func => $0#value#parameter):join<, >;
      local PropsArguments @= local#PropsModel:map(func => $0#value#argument):join<, >;
      local PropsAssignments @= local#PropsModel:map(func => $0#value#assignment):join< >;
      emit<Class>
        @> public partial struct Props {
        @>   public Props({{local#PropsParameters}}) {
        @>     {{local#PropsAssignments}}
        @>   }
        @> }
      emit<Implements> @> IProps<{{this:type}}.Props>
      emit<Class>
        @> private Props _props;
        @> public ref Props props => ref _props;
        @> public void ReceiveProps(in Props props) => _props = props;
      inject(<$Reset>, 1) @> _props = default;
      local ComposeArgs @> {{local#ComposeArgs}}, {{local#PropsParameters}}
      local ComposeCalls
        @> {{local#ComposeCalls}}
        @> var props = new {{this:type}}.Props({{local#PropsArguments}});
        @> instance.ReceiveProps(in props);
      goto GenerateCompose
    }
  }
  emit<Class> @> public static readonly Composable BakedComposable = static (ref Composition cx) => { ComposeBoundary(ref cx); };
  :GenerateCompose
  local Body
    @> {
    @>   if (!cx.AUTHORING.RequireComposable<{{this:type}}>({{var#CompanionName}}.typeId, out var instance, out var retained)) {
    @>     instance = new {{this:type}}();
    @>   }
    @>   {{local#ComposeCalls}}
    @>   return ref cx.AUTHORING.YieldBoundary(ref cx, instance);
    @> }
  emit<Class>
    @> public static ref ElementRef ComposeBoundary(
    @>   ref Composition cx{{local#ComposeArgs}}
    @> ) {{local#Body}}
  local Name @= this:name;
  when(![attr#name:unwrap:eq(null)]) {
    local Name @= attr#name:unwrap;
  }
  when(attr#extension:unwrap:eq(true)) {
    DeclareCompanion
      @> public static ref ElementRef {{local#Name}}(
      @>  ref this Composition cx{{local#ComposeArgs}}
      @> ) {{local#Body}}
  }
  inject(<$Recompose>, -24) @> cx.AUTHORING.SetId({{var#CompanionName}}.fullId);
}

