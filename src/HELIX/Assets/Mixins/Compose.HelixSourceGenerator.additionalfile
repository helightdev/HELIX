%backend<Unity>
---
func RequireCompositionTypeId() -> null {
  when(![var#HasTypeId:eq(true)]) {
    var<HasTypeId> @= true;
    DeclareCompanion @> public static readonly ushort typeId = CompositionId.GetTypeId("{{this:name}}");
  }
}

func RequireCompositionId() -> null {
  when(![var#HasCompositionId:eq(true)]) {
    var<HasCompositionId> @= true;
    DeclareCompanion @> public static readonly ushort compositionId = CompositionId.GetCompositionId("{{this:name}}");
  }
}

func RequireInputState() -> null {
  when(![var#HasInputState:eq(true)]) {
    var<HasInputState> @= true;
    using @> HELIX.Compose;
    emit<Implements> @> IStateHolder
    emit<Class>
      @> private State inputState;
      @>  public ref State InputState => ref inputState;
  }
}

func GenerateBoundaryElement(%optional string name, bool extension) -> null {
  local ComposeCalls = <>
  local ComposeArgs = <>
  RequireCompositionTypeId()
  RequireCompositionId()
  DeclareCompanion
    @> public static readonly CompositionId fullId = new() {
    @>   composition = compositionId,
    @>   type = typeId,
    @>   local = LocalId.Initial
    @> };
  when(this#Props:exists) {
    local PropsModel @= this#Props:DeriveFields;
    when(![$PropsModel:length:eq(0)]) {
      local PropsParameters @= $PropsModel:map(func => $0#value#parameter):join<, >;
      local PropsArguments @= $PropsModel:map(func => $0#value#argument):join<, >;
      local PropsAssignments @= $PropsModel:map(func => $0#value#assignment):join< >;
      emit<Class>
        @> public partial struct Props {
        @>   public Props({{$PropsParameters}}) {
        @>     {{$PropsAssignments}}
        @>   }
        @> }
      emit<Implements> @> IProps<{{this:type}}.Props>
      emit<Class>
        @> private Props _props;
        @> public ref Props props => ref _props;
        @> public void ReceiveProps(in Props props) => _props = props;
      inject(<$Reset>, 1) @> _props = default;
      $ComposeArgs @> {{$ComposeArgs}}, {{$PropsParameters}}
      $ComposeCalls
        @> {{$ComposeCalls}}
        @> var props = new {{this:type}}.Props({{$PropsArguments}});
        @> instance.ReceiveProps(in props);
      goto GenerateCompose
    }
  }
  emit<Class> @> public static readonly Composable BakedComposable = static (ref Composition cx) => { ComposeBoundary(ref cx); };
  :GenerateCompose
  local Body
    @> {
    @>   if (!cx.AUTHORING.RequireComposable<{{this:type}}>({{var#CompanionName}}.typeId, out var instance, out var retained)) {
    @>     instance = new {{this:type}}();
    @>   }
    @>   {{$ComposeCalls}}
    @>   return ref cx.AUTHORING.YieldBoundary(ref cx, instance);
    @> }
  emit<Class>
    @> public static ref ElementRef ComposeBoundary(
    @>   ref Composition cx{{$ComposeArgs}}
    @> ) {{$Body}}
  local Name @= this:name;
  when(![$name:eq(null)]) {
    $Name @= $name;
  }
  when($extension:eq(true)) {
    DeclareCompanion
      @> public static ref ElementRef {{$Name}}(
      @>  ref this Composition cx{{$ComposeArgs}}
      @> ) {{$Body}}
  }
  inject(<$Recompose>, -24) @> cx.AUTHORING.SetId({{var#CompanionName}}.fullId);
}

mixin HELIX.Compose.ComposableMethodAttribute(bool requiresTracking = [false], bool scope = [false],
  bool extension = [false], string name = [null], string scopeCallback = [<cell.TrimChildren\(\)>]) {
  prelude expression {
    using @> HELIX.Compose;
    local StructName @> {{target:name}}Props
    local StructHandle @= target:DeriveParameters;
    local StructArgs @= $StructHandle:map(func => $0#value#argument):join<, >;
    local StructParams @= $StructHandle:map(func => $0#value#parameter):join<, >;
    local RequireMethod = <RequireComposable>
    local ReturnStatement @> return ref cx.AUTHORING.YieldElement(ref cx, instance);
    local ReturnType = <ref ElementRef>
    local Name @= this:name;
    when($requiresTracking:eq(true)) {
      $RequireMethod = <RequireTracked>
    }
    when(![$name:eq(null)]) {
      $Name @= $name;
    }
    when($scope:eq(true)) {
      $ReturnType = <ScopeHandle>
      $ReturnStatement @> return cx.AUTHORING.YieldScope(ref cx, instance, static (BoundaryCell cell, in ScopeHandle handle) => {{$scopeCallback}});
    }
    RequireCompositionTypeId()
    local Body
      @> if (!cx.AUTHORING.{{$RequireMethod}}<{{this:name}}>({{var#CompanionName}}.typeId, out var instance, out var retained)) {
      @>     instance = new {{this:name}}();
      @>   }
      @>   instance.{{target:name}}({{$StructArgs}});
      @>   {{$ReturnStatement}}
    local ParameterSuffix = when {
      ($StructParams) -> <, [$StructParams]>
      else -> <>
    }
    when($extension:eq(true)) {
      DeclareCompanion
        @>
        @>   public static {{$ReturnType}} {{$Name}}(
        @>     ref this Composition cx{{$ParameterSuffix}}
        @>   ) {
        @>     {{$Body}}
        @>   }
      return
    }
    {
      emit<Class>
        @> public static {{$ReturnType}} Compose(
        @>  ref Composition cx{{$ParameterSuffix}}
        @> ) {
        @>   {{$Body}}
        @> }
    }
  }
}

mixin HELIX.Compose.ComposableDelegateAttribute(string name = [null]) {
  prelude expression {
    using @> HELIX.Compose;
    local Name @= target:name:regexReplaceFirst<^_><>;
    when(![$name:eq(null)]) {
      $Name @= $name;
    }
    local Args = <ref Composition cx>
    local CallArgs = <ref cx>
    local Types = <>
    {
      when(target#1:exists:not) {
        goto NoArgs
      }
      $Args @> {{$Args}}, {{target#1:type:unwrap}} {{target#1:name}}
      $CallArgs @> {{$CallArgs}}, {{target#1:name}}
      $Types @= target#1:type:unwrap;
    }
    when(target#2:exists) {
      $Args @> {{$Args}}, {{target#2:type:unwrap}} {{target#2:name}}
      $CallArgs @> {{$CallArgs}}, {{target#2:name}}
      $Types @> {{$Types}}, {{target#2:type:unwrap}}
    }
    when(target#3:exists) {
      $Args @> {{$Args}}, {{target#3:type:unwrap}} {{target#3:name}}
      $CallArgs @> {{$CallArgs}}, {{target#3:name}}
      $Types @> {{$Types}}, {{target#3:type:unwrap}}
    }
    $Types @> <{{$Types}}>
    :NoArgs
    local IdName @> _{{$Name}}CompositionId
    emit<Class>
      @> private static readonly ushort {{$IdName}} = CompositionId.GetCompositionId("{{$Name}}");
      @> public static readonly Composable{{$Types}} {{$Name}} = static ({{$Args}}) => {
      @>   var transfer = new CompositionInternals.TransferData();
      @>   CompositionInternals.EnterComposition(ref cx, {{$IdName}}, ref transfer);
      @>   try {
      @>     {{target:name}}({{$CallArgs}});
      @>   } finally {
      @>     CompositionInternals.ExitComposition(ref cx, ref transfer);
      @>   }
      @> };
  }
}

mixin HELIX.Compose.CustomBoundaryElementAttribute(bool constructor = [true], bool composable = [true],
  bool extension = [false], bool cacheLookups = [false], bool trimChildren = [true], string name = [null]) {
  prelude expression {
    defineTarget<$Compose> @> PerformCompose:HELIX.Compose.Composable
    defineTarget<$Recompose> @> ^Recompose
    defineTarget<$Reset> @> ^Reset
    defineTarget<$Init> @> Init
    defineTarget<$Dispose> @> ^Dispose
    defineTarget<$PostConstruct> @> ^PostConstruct
    when($composable:eq(true)) {
      GenerateBoundaryElement($name, $extension)
    }
  }
  prelude expression {
    using @> HELIX.Compose;
    using @> HELIX.Coloring;
    when(![this:is<global::UnityEngine.UIElements.VisualElement>]) {
      emit<Extends> @> global::UnityEngine.UIElements.VisualElement
    }
    emit<Implements> @> IBoundary
    emit<Implements> @> IRecomposeMixinTargets
    emit<Class>
      @>
      @> public global::UnityEngine.UIElements.VisualElement Element => this;
      @> public BoundaryCell Cell { get; } = BoundaryCell.Shared;
      @> public int TreeDepth { get; set; }
      @> public IBoundary Parent { get; set; }
      @> public IContextComposable ContextParent { get; set; }
      @> public bool IsDisposed { get; set; }
      @> public UssFlag Flag { get; set; }
      @> public ulong PackedId { get; set; }
      @> public SparseContextMap WrittenContext { get;set; }
      @>
      @> private LookupCache _lookupCache;
      @> private bool _initialAttachment = true;
      @> private bool _initialized = false;
      @> public bool TryLookupContext(int key, out ContextData data) {
      @>   data = null;
      @>   if (WrittenContext != null && WrittenContext.TryGet(key, out data)) return true;
      @>   return _lookupCache.TryLookup(ContextParent, key, out data);
      @> }
      @>
      @> public void RefreshHierarchy() {
      @>   Parent = GetFirstAncestorOfType<IBoundary>();
      @>   ContextParent = GetFirstAncestorOfType<IContextComposable>();
      @>   TreeDepth = BoundaryHelper.GetDepth(this);
      @> }
      @> public void MarkDirty() => HXComposer.MarkDirty(this, false);
    inject(<$Recompose>, -1000) @> try {
    inject(<$Recompose>, -100) @> BoundaryHelper.ContextBefore(this);
    inject(<$Recompose>, -75) @> _lookupCache.Clear();
    inject(<$Recompose>, -60) @> if (!_initialized) Init();
    when($cacheLookups) {
      inject(<$Recompose>, -55) @> _lookupCache.Claim();
    }
    inject(<$Recompose>, -50) @> try {
    inject(<$Recompose>, -25) @> var cx = new Composition(this);
    inject(<$Recompose>, 0) @> PerformCompose(ref cx)
    inject(<$Recompose>, 50) @> } catch (global::System.Exception e) { global::UnityEngine.Debug.LogException(e); }
    inject(<$Recompose>, 100) @> BoundaryHelper.ContextAfter(this);
    when($trimChildren) {
      inject(<$Recompose>, 200) @> Cell.TrimChildren();
    }
    inject(<$Recompose>, 1000) @> } catch (global::System.Exception e) { global::UnityEngine.Debug.LogException(e); }
    inject(<$Reset>, -1) @> HXComposer.RemoveDirty(this);
    inject(<$Reset>, 1) @> _lookupCache.Release();
    inject(<$Reset>, 100) @> _initialized = false;
    inject(<$Compose>, 0) @> // Default handle
    inject(<$Init>, 100) @> _initialized = true;
    inject(<$Dispose>, -100) @> if (IsDisposed) return; IsDisposed = true; _initialized = false;
    inject(<$Dispose>, -1) @> Reset();
    inject(<$PostConstruct>, 1000)
      @> if (HXComposer.IsProcessing) {
      @>   _initialAttachment = false;
      @>   HXComposer.MarkDirty(this);
      @> }
    inject(<DetachBoundary>, 0)
      @>
      @> _initialAttachment = true;
      @> _lookupCache.Release();
      @> HXComposer.NotifyDetach(this);
    inject(<AttachBoundary>, 0)
      @>
      @> IsDisposed = false;
      @> RefreshHierarchy();
    inject(<AttachBoundary>, 100) @> HXComposer.RegisterActiveBoundary(this);
    inject(<AttachBoundary>, 200)
      @> if (_initialAttachment) {
      @>   _initialAttachment = false;
      @>   HXComposer.MarkDirty(this);
      @> }
    when($constructor:eq(true)) {
      emit<Class>
        @> public {{this:name}}() {
        @>   RegisterCallback<global::UnityEngine.UIElements.AttachToPanelEvent>(_ => AttachBoundary());
        @>   RegisterCallback<global::UnityEngine.UIElements.DetachFromPanelEvent>(_ => DetachBoundary());
        @>   PostConstruct();
        @> }
    }
  }
}

mixin HELIX.Compose.BoundaryElementMixinAttribute(bool composable = [true], bool extension = [false],
  bool cacheLookups = [false], bool trimChildren = [true], string name = [null]) {
  prelude expression {
    defineTarget<$Init> @> ^MixinInit
    defineTarget<$Compose> @> ^MixinCompose:HELIX.Compose.Composable
    defineTarget<$Recompose> @> ^MixinRecompose:HELIX.Compose.Composable
    defineTarget<$Reset> @> ^MixinReset
    defineTarget<$Dispose> @> ^MixinDispose
    defineTarget<$PostConstruct> @> ^MixinPostConstruct
    emit<Class> @> public {{this:name}}() : base({{$cacheLookups}}, {{$trimChildren}}) {}
    emit<Extends> @> HELIX.Compose.GeneratedBoundaryBase
    when($composable:eq(true)) {
      GenerateBoundaryElement($name, $extension)
    }
  }
  expression {
    using @> HELIX.Compose;
    using @> HELIX.Coloring;
    emit<Implements> @> HELIX.Compose.IBoundaryHooks
    inject(<$Recompose>, 0) @> ((IBoundaryHooks)this).MixinCompose(ref cx);
  }
}

mixin HELIX.Compose.WriteContextHandlerAttribute {
  prelude expression {
    assert(![var#HasWriteContext:eq(true)])
    inject(<$Compose>, -1)
      @> using (cx.WriteContext(out var context)) {
      @>   {{target:name}}(ref cx, context);
      @> }
    var<HasWriteContext> @= true;
  }
}

mixin HELIX.Compose.ClickHandlerAttribute {
  prelude expression {
    RequireInputState()
    inject(<$PostConstruct>, 0)
      @> global::UnityEngine.UIElements.VisualElementExtensions.AddManipulator(this,
      @>   new InputClickableManipulator(this, this, {{target:name}})
      @> );
  }
}

mixin HELIX.Compose.InputStateListenerAttribute(bool focus = [true], bool hover = [true], bool dirty = [true]) {
  prelude expression {
    RequireInputState()
    inject(<$PostConstruct>, 0)
      @> global::UnityEngine.UIElements.VisualElementExtensions.AddManipulator(this,
      @>   new InputListenerManipulator(this, this, {{$focus}})
      @> );
    when($dirty:eq(true)) {
      inject(<^OnStateChanged:HELIX.Compose.StateChangedHandler>, 0) @> this.MarkDirty();
    }
  }
}
