      @>     instance = new {{this:name}}();
      @>   }
      @>   instance.{{target:name}}({{local#StructArgs}});
      @>   {{local#ReturnStatement}}
    local ParameterSuffix = when {
      (local#StructParams) -> <, [local#StructParams]>
      else -> <>
    }
    when(attr#extension:unwrap:eq(true)) {
      DeclareCompanion
        @>
        @>   public static {{local#ReturnType}} {{local#Name}}(
        @>     ref this Composition cx{{local#ParameterSuffix}}
        @>   ) {
        @>     {{local#Body}}
        @>   }
      return
    }
    {
      emit<Class>
        @> public static {{local#ReturnType}} Compose(
        @>  ref Composition cx{{local#ParameterSuffix}}
        @> ) {
        @>   {{local#Body}}
        @> }
    }
  }
}

mixin HELIX.Compose.ComposableDelegateAttribute {
  prelude expression {
    using @> HELIX.Compose;
    local Name @= target:name:regexReplaceFirst<^_><>;
    when(![attr#name:unwrap:eq(null)]) {
      local Name @= attr#name:unwrap;
    }
    local Args = <ref Composition cx>
    local CallArgs = <ref cx>
    local Types = <>
    {
      when(target#1:exists:not) {
        goto NoArgs
      }
      local Args @> {{local#Args}}, {{target#1:type:unwrap}} {{target#1:name}}
      local CallArgs @> {{local#CallArgs}}, {{target#1:name}}
      local Types @= target#1:type:unwrap;
    }
    when(target#2:exists) {
      local Args @> {{local#Args}}, {{target#2:type:unwrap}} {{target#2:name}}
      local CallArgs @> {{local#CallArgs}}, {{target#2:name}}
      local Types @> {{local#Types}}, {{target#2:type:unwrap}}
    }
    when(target#3:exists) {
      local Args @> {{local#Args}}, {{target#3:type:unwrap}} {{target#3:name}}
      local CallArgs @> {{local#CallArgs}}, {{target#3:name}}
      local Types @> {{local#Types}}, {{target#3:type:unwrap}}
    }
    local Types @> <{{local#Types}}>
    :NoArgs
    local IdName @> _{{local#Name}}CompositionId
    emit<Class>
      @> private static readonly ushort {{local#IdName}} = CompositionId.GetCompositionId("{{local#Name}}");
      @> public static readonly Composable{{local#Types}} {{local#Name}} = static ({{local#Args}}) => {
      @>   var transfer = new CompositionInternals.TransferData();
      @>   CompositionInternals.EnterComposition(ref cx, {{local#IdName}}, ref transfer);
      @>   try {
      @>     {{target:name}}({{local#CallArgs}});
      @>   } finally {
      @>     CompositionInternals.ExitComposition(ref cx, ref transfer);
      @>   }
      @> };
  }
}

mixin HELIX.Compose.CustomBoundaryElementAttribute {
  prelude expression {
    defineTarget<$Compose> @> PerformCompose:HELIX.Compose.Composable
    defineTarget<$Recompose> @> ^Recompose
    defineTarget<$Reset> @> ^Reset
    defineTarget<$Init> @> Init
    defineTarget<$Dispose> @> ^Dispose
    defineTarget<$PostConstruct> @> ^PostConstruct
    when(attr#composable:unwrap:eq(true)) {
      GenerateBoundaryElement()
    }
  }
  prelude expression {
    using @> HELIX.Compose;
    using @> HELIX.Coloring;
    when(![this:is<global::UnityEngine.UIElements.VisualElement>]) {
      emit<Extends> @> global::UnityEngine.UIElements.VisualElement
    }
    emit<Implements> @> IBoundary
    emit<Implements> @> IRecomposeMixinTargets
    emit<Class>
      @>
      @> public global::UnityEngine.UIElements.VisualElement Element => this;
      @> public BoundaryCell Cell { get; } = BoundaryCell.Shared;
      @> public int TreeDepth { get; set; }
      @> public IBoundary Parent { get; set; }
      @> public IContextComposable ContextParent { get; set; }
      @> public bool IsDisposed { get; set; }
      @> public UssFlag Flag { get; set; }
      @> public ulong PackedId { get; set; }
      @> public SparseContextMap WrittenContext { get;set; }
      @>
      @> private LookupCache _lookupCache;
      @> private bool _initialAttachment = true;
      @> private bool _initialized = false;
      @> public bool TryLookupContext(int key, out ContextData data) {
      @>   data = null;
      @>   if (WrittenContext != null && WrittenContext.TryGet(key, out data)) return true;
      @>   return _lookupCache.TryLookup(ContextParent, key, out data);
      @> }
      @>
      @> public void RefreshHierarchy() {
      @>   Parent = GetFirstAncestorOfType<IBoundary>();
      @>   ContextParent = GetFirstAncestorOfType<IContextComposable>();
      @>   TreeDepth = BoundaryHelper.GetDepth(this);
      @> }
      @> public void MarkDirty() => HXComposer.MarkDirty(this, false);
    inject(<$Recompose>, -1000) @> try {
    inject(<$Recompose>, -100) @> BoundaryHelper.ContextBefore(this);
    inject(<$Recompose>, -75) @> _lookupCache.Clear();
    inject(<$Recompose>, -60) @> if (!_initialized) Init();
    when(attr#cacheLookups:unwrap) {
      inject(<$Recompose>, -55) @> _lookupCache.Claim();
    }
    inject(<$Recompose>, -50) @> try {
    inject(<$Recompose>, -25) @> var cx = new Composition(this);
    inject(<$Recompose>, 0) @> PerformCompose(ref cx)
    inject(<$Recompose>, 50) @> } catch (global::System.Exception e) { global::UnityEngine.Debug.LogException(e); }
    inject(<$Recompose>, 100) @> BoundaryHelper.ContextAfter(this);
    when(attr#trimChildren:unwrap) {
      inject(<$Recompose>, 200) @> Cell.TrimChildren();
    }
    inject(<$Recompose>, 1000) @> } catch (global::System.Exception e) { global::UnityEngine.Debug.LogException(e); }
    inject(<$Reset>, -1) @> HXComposer.RemoveDirty(this);
    inject(<$Reset>, 1) @> _lookupCache.Release();
    inject(<$Reset>, 100) @> _initialized = false;
    inject(<$Compose>, 0) @> // Default handle
    inject(<$Init>, 100) @> _initialized = true;
    inject(<$Dispose>, -100) @> if (IsDisposed) return; IsDisposed = true; _initialized = false;
    inject(<$Dispose>, -1) @> Reset();
    inject(<$PostConstruct>, 1000)
      @> if (HXComposer.IsProcessing) {
      @>   _initialAttachment = false;
      @>   HXComposer.MarkDirty(this);
      @> }
    inject(<DetachBoundary>, 0)
      @>
      @> _initialAttachment = true;
      @> _lookupCache.Release();
      @> HXComposer.NotifyDetach(this);
    inject(<AttachBoundary>, 0)
      @>
      @> IsDisposed = false;
      @> RefreshHierarchy();
    inject(<AttachBoundary>, 100) @> HXComposer.RegisterActiveBoundary(this);
    inject(<AttachBoundary>, 200)
      @> if (_initialAttachment) {
      @>   _initialAttachment = false;
      @>   HXComposer.MarkDirty(this);
      @> }
    when(attr#constructor:unwrap:eq(true)) {
      emit<Class>
        @> public {{this:name}}() {
        @>   RegisterCallback<global::UnityEngine.UIElements.AttachToPanelEvent>(_ => AttachBoundary());
        @>   RegisterCallback<global::UnityEngine.UIElements.DetachFromPanelEvent>(_ => DetachBoundary());
        @>   PostConstruct();
        @> }
    }
  }
}

