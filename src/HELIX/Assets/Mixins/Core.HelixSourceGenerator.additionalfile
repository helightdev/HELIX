%backend<Unity>
---

type DerivedProperty = @{
  string name,
  symbol type,
  string modifier,
  string parameter,
  string argument,
  string callArgument,
  string assignment,
  string datatype,
  bool required,
  any default,
  string configuration,
  bool equatable,
  bool unsafe,
  string equality,
  string hash
}
type DerivedPropertyEntry = @{symbol symbol, DerivedProperty value}
type DerivedProperties = %many<DerivedPropertyEntry>

func KeepInstanceField -> bool {
  local Item @= $0;
  when(![$Item:field]) {
    return(false)
  }
  when($Item:static) {
    return(false)
  }
  return(true)
}

func SeedProp -> table {
  local Item @= $0;
  local Name @= $Item:name:identifier;
  local Type @= $Item:type;
  local Modifier = <>
  local ParameterModifier = <>
  when [$Item] {
    [:in] -> { $Modifier = <in>; $ParameterModifier = <in> }
    [:ref] -> { $Modifier = <ref> }
    [:out] -> { $Modifier = <out> }
  }
  local selfType @> <{{$Type}}>()
  local Datatype = when [$Type] {
    [:is<System.String>] -> <global::HELIX.Datatypes.String>
    [:is<System.Int32>] -> <global::HELIX.Datatypes.Int>
    [:is<System.Int64>] -> <global::HELIX.Datatypes.Long>
    [:is<System.Single>] -> <global::HELIX.Datatypes.Float>
    [:is<System.Double>] -> <global::HELIX.Datatypes.Double>
    [:is<System.Boolean>] -> <global::HELIX.Datatypes.Bool>
    [:enum] -> <global::HELIX.Datatypes.Enum[$selfType]>
    [:is<UnityEngine.Color>] -> <global::HELIX.Datatypes.Color>
    [:is<UnityEngine.Vector2>] -> <global::HELIX.Datatypes.Vector2>
    [:is<UnityEngine.Vector3>] -> <global::HELIX.Datatypes.Vector3>
    [:is<UnityEngine.Vector4>] -> <global::HELIX.Datatypes.Vector4>
    else -> <global::HELIX.Datatypes.Object[$selfType]>
  }

  local Equality @> global::System.Collections.Generic.EqualityComparer<{{$Type}}>.Default.Equals(this.{{$Name}}, other.{{$Name}})
  local Hash @> this.{{$Name}}
  when($Type:primitive) {
    $Equality @> this.{{$Name}} == other.{{$Name}}
  }
  when($Type:pointer) {
    $Equality @> this.{{$Name}} == other.{{$Name}}
    $Hash @> ((global::System.IntPtr)this.{{$Name}})
  }
  local ModifierPrefix = when {
    ($Modifier) -> <[$Modifier] >
    else -> <>
  }
  local ParameterModifierPrefix = when {
    ($ParameterModifier) -> <[$ParameterModifier] >
    else -> <>
  }
  return(@{symbol=$Item, value=@{name=$Name, type=$Type, modifier=$ModifierPrefix, parameter=<[$ParameterModifierPrefix][$Type] [$Name]>, argument=<[$ParameterModifierPrefix][$Name]>, callArgument=<[$ModifierPrefix][$Name]>, assignment=<this.[$Name] = [$Name];>, datatype=$Datatype, required=true, default=<null>, configuration=<>, equatable=true, unsafe=$Type:containsPointer, equality=$Equality, hash=$Hash}})
}

func DeriveParameters(symbol value) -> DerivedProperties {
  assert(![$value:genericMethod])
  tar<PropOptional> @= false;
  return($value:parameters:map(SeedProp):derive)
}

func DeriveFields(symbol value) -> DerivedProperties {
  tar<PropOptional> @= false;
  return($value:members:where(KeepInstanceField):map(SeedProp):derive)
}

func SelectDatatypeProperty(DerivedPropertyEntry value) -> string {
  local returnedText1 @> new global::HELIX.StructurePropertyDatatype<{{var#StructureType}}, {{$value#value#type}}>("{{$value#value#name}}", {{$value#value#datatype}}, (ref {{var#StructureType}} value) => value.{{$value#value#name}}, (ref {{var#StructureType}} value, {{$value#value#type}} propertyValue) => value.{{$value#value#name}} = propertyValue, required: {{$value#value#required}}, defaultValue: {{$value#value#default}})
  return($returnedText1)
}

func BuildDatatype(string type, string name, DerivedProperties props) -> string {
  var<StructureType> @= param#type;
  local Empty = <>
  local PropertySeparator
    @> ,
    @>       {{$Empty}}
  local Properties @= param#props:map(SelectDatatypeProperty):join($PropertySeparator);
  local Configurations @= param#props:where(func => $0#value#configuration:exists):map(func => $0#value#configuration):join< >;
  local returnedText2
    @> public static readonly global::HELIX.StructureDatatype<{{param#type}}> Datatype =
    @> new global::HELIX.ConfigurableStructureDatatype<{{param#type}}>(
    @>   new global::HELIX.StructureDatatype<{{param#type}}>(
    @>     "{{param#name}}",
    @>     new global::HELIX.StructurePropertyDatatype<{{param#type}}>[] {
    @>       {{$Properties}}
    @>     }),
    @>   datatype => ConfigureDatatype(datatype)).Datatype;
    @> static void ConfigureDatatype(global::HELIX.StructureDatatype<{{param#type}}> datatype) {
    @>   {{$Configurations}}
    @> }
  return($returnedText2)
}

func EmitGeneratedStructure(string name, DerivedProperties props, bool datatype) -> DerivedProperties {
  local Fields @= param#props:map(func => <public [$0#value#type] [$0#value#name];>):join< >;
  local Parameters @= param#props:map(func => $0#value#parameter):join<, >;
  local Assignments @= param#props:map(func => $0#value#assignment):join< >;
  local Datatype = <>
  when(param#datatype:eq(true)) {
    $Datatype @= BuildDatatype(param#name, param#name, param#props);
  }
  local Constructor = <>
  when(![param#props:length:eq(0)]) {
    $Constructor
      @> public {{param#name}}({{$Parameters}}) {
      @>   {{$Assignments}}
      @> }
  }
  local Unsafe = <>
  when(![param#props:where(func => $0#value#unsafe:eq(true)):length:eq(0)]) {
    $Unsafe = <unsafe>
  }
  emit<Class>
    @> public {{$Unsafe}} struct {{param#name}} {
    @>   {{$Fields}}
    @>   {{$Constructor}}
    @>   {{$Datatype}}
    @> }
  return(param#props)
}

func RequireCompanion() -> null {
  when(![var#CompanionName:exists]) {
    var<CompanionName> @> {{this:name}}_Companion
    var<DeclareCompanion> @> public static partial class {{var#CompanionName}}
    emit<File> @> {{var#DeclareCompanion}} {}
  }
}

func DeclareCompanion(string value) -> null {
  when(![var#CompanionName:exists]) {
    var<CompanionName> @> {{this:name}}_Companion
    var<DeclareCompanion> @> public static partial class {{var#CompanionName}}
  }
  emit<File>
    @> {{var#DeclareCompanion}} {
    @>   {{$value}}
    @> }
}

derivation mixin HELIX.PropertyDatatypeAttribute {
  prelude expression {
    local Datatype @= param#symbol:attributeOf<HELIX.PropertyDatatypeAttribute>;
    when($Datatype:exists) {
      return(param#value:put(<datatype>, $Datatype#datatype:unwrap))
    }
    return(param#value)
  }
}

derivation mixin HELIX.PropAttribute {
  prelude expression {
    local Prop @= param#symbol:attributeOf<HELIX.PropAttribute>;
    when(![$Prop:exists]) {
      assert(![tar#PropOptional:eq(true)])
      return(param#value)
    }
    local Mode @= $Prop#defaultInit:unwrap;
    when(![$Mode:exists]) {
      assert(![tar#PropOptional:eq(true)])
      return(param#value)
    }
    when($Mode:eq(3)) {
      assert(![tar#PropOptional:eq(true)])
      return(param#value)
    }
    when($Mode:eq<None>) {
      assert(![tar#PropOptional:eq(true)])
      return(param#value)
    }
    when($Mode:eq<HELIX.PropInit.None>) {
      assert(![tar#PropOptional:eq(true)])
      return(param#value)
    }
    when($Mode:eq(0)) {
      assert($Prop#defaultValue:parameterDefault)
    }
    when($Mode:eq(1)) {
      assert($Prop#defaultValue:nonEmptyStringConstant)
    }
    when($Mode:eq(2)) {
      assert($Prop#defaultValue:nonEmptyStringConstant)
    }
    assert(![param#symbol:in])
    tar<PropOptional> @= true;
    local Default @= $Prop#defaultValue:csharpLiteral;
    local Parameter @> {{param#value#type}} {{param#value#name}} = {{$Default}}
    local Assignment @> this.{{param#value#name}} = {{param#value#name}};
    when($Mode:eq<Constant>) {
      $Default @= $Prop#defaultValue:unwrap;
      $Parameter @> {{param#value#type}} {{param#value#name}} = {{$Default}}
    }
    when($Mode:eq<HELIX.PropInit.Constant>) {
      $Default @= $Prop#defaultValue:unwrap;
      $Parameter @> {{param#value#type}} {{param#value#name}} = {{$Default}}
    }
    when($Mode:eq(1)) {
      $Default @= $Prop#defaultValue:unwrap;
      $Parameter @> {{param#value#type}} {{param#value#name}} = {{$Default}}
    }
    when($Mode:eq(2)) {
      $Default @= $Prop#defaultValue:unwrap;
      $Parameter @> {{param#symbol:nullableType}} {{param#value#name}} = null
      $Assignment @> this.{{param#value#name}} = {{param#value#name}} ?? {{$Default}};
    }
    local Value @= param#value:put(<parameter>, $Parameter):put(<assignment>, $Assignment):put(<required>, false):put(<default>, $Default);
    when($Prop#Equatable:unwrap:eq(false)) {
      $Value @= $Value:put(<equatable>, false);
    }
    when($Prop#Datatype:exists) {
      $Value @= $Value:put(<datatype>, $Prop#Datatype:unwrap);
    }
    when($Prop#EqualitySyntax:exists, ![param#symbol:type:primitive], ![param#symbol:type:pointer]) {
      assert($Prop#EqualitySyntax:unwrap:matches<\\S>)
      local Equality @= $Prop#EqualitySyntax:unwrap:replaceAll(<\{0\}>, <this.[param#value#name]>):replaceAll(<\{1\}>, <other.[param#value#name]>);
      $Value @= $Value:put(<equality>, $Equality);
    }
    when($Prop#HashCodeSyntax:exists, ![param#symbol:type:primitive], ![param#symbol:type:pointer]) {
      assert($Prop#HashCodeSyntax:unwrap:matches<\\S>)
      local Hash @= $Prop#HashCodeSyntax:unwrap:replaceAll(<\{0\}>, <this.[param#value#name]>);
      $Value @= $Value:put(<hash>, $Hash);
    }
    return($Value)
  }
}

mixin HELIX.StructureAttribute(bool datatype = [false]) {
  prelude expression {
    local PropsModel @= this:DeriveFields;
    local Parameters @= $PropsModel:map(func => $0#value#parameter):join<, >;
    local Assignments @= $PropsModel:map(func => $0#value#assignment):join< >;
    when(![$PropsModel:length:eq(0)]) {
      emit<Class>
        @> {{this:visibility}} {{this:name}}({{$Parameters}}) {
        @>   {{$Assignments}}
        @> }
    }
    local EqualityProps @= $PropsModel:where(func => $0#value#equatable:eq(true));
    local Comparisons @= $EqualityProps:map(func => $0#value#equality):join< && >;
    local HashAdds @= $EqualityProps:map(func => <hashCode.Add\([$0#value#hash]\);>):join< >;
    local Unsafe = <>
    when(this:equatableSelf, ![$EqualityProps:where(func => $0#value#unsafe:eq(true)):length:eq(0)]) {
      $Unsafe = <unsafe>
    }
    when(this:equatableSelf, ![this:typedEqualsSelf]) {
      local EqualityBody = when {
        ($Comparisons) -> [$Comparisons]
        else -> <true>
      }
      emit<Class> @> public {{$Unsafe}} bool Equals({{this:type}} other) => {{$EqualityBody}};
    }
    local TypedEqualsCall = <Equals\(other\)>
    when(this:equatableSelf, this:typedEqualsSelf, ![this:ordinaryTypedEqualsSelf]) {
      $TypedEqualsCall @> ((global::System.IEquatable<{{this:type}}>)this).Equals(other)
    }
    when(this:equatableSelf, ![this:objectEquals]) {
      emit<Class> @> public override bool Equals(object obj) => obj is {{this:type}} other && {{$TypedEqualsCall}};
    }
    when(this:equatableSelf, ![this:hashCode]) {
      emit<Class>
        @> public override {{$Unsafe}} int GetHashCode() {
        @>   var hashCode = new global::System.HashCode();
        @>   {{$HashAdds}}
        @>   return hashCode.ToHashCode();
        @> }
    }
    when($datatype:eq(true)) {
      local DatatypeCode @= BuildDatatype(this:type, this:name, $PropsModel);
      emit(<Class>, $DatatypeCode)
    }
  }
}

mixin HELIX.HookAttribute(string target = [null], number order = [0]) {
  prelude expression {
    local Name @= $target;
    when($Name:eq(null)) {
      assert(target:name:matches<^On.*>)
      local IsImplicit @= true;
      $Name @> ${{target:name:regexReplaceFirst<^On><>}}
    }
    when(![target#0:exists]) {
      inject($Name, $order) @> {{target:name}}();
      return<>
    }
    local Delegate @= resolveMixin(<Delegate>, $Name);
    assert(![$Delegate:eq(null)])
    inject($Name, $order) @> {{target:name}}({{$Delegate:wire(target)}});
  }
}

mixin HELIX.MixinUsingAttribute(string statement) {
  prelude expression {
    using @> {{$statement}};
  }
}
