@FUNC<BuildDatatype>
  @VAR<StructureType> @param#type
  @LOCAL<Empty> @table:joinValues<>
  @LOCAL<PropertySeparator>,
    @\      @local#Empty
  @LOCAL<Properties> @param#props:mapValues<SelectDatatypeProperty>:joinValues<(@local#PropertySeparator)>
  @LOCAL<Configurations> @param#props:filter<HasDatatypeConfiguration>:mapValues<SelectDatatypeConfiguration>:joinValues< >
  @RETURN public static readonly global::HELIX.StructureDatatype<@param#type> Datatype =
    @\new global::HELIX.ConfigurableStructureDatatype<@param#type>(
    @\  new global::HELIX.StructureDatatype<@param#type>(
    @\    "@param#name",
    @\    new global::HELIX.StructurePropertyDatatype<@param#type>[] {
    @\      @local#Properties
    @\    }),
    @\  datatype => ConfigureDatatype(datatype)).Datatype;
    @\static void ConfigureDatatype(global::HELIX.StructureDatatype<@param#type> datatype) {
    @\  @local#Configurations
    @\}
@END

@FUNC<EmitGeneratedStructure>
  @LOCAL<Fields> @param#props:mapValues<SelectField>:joinValues< >
  @LOCAL<Parameters> @param#props:mapValues<SelectParameter>:joinValues<, >
  @LOCAL<Assignments> @param#props:mapValues<SelectAssignment>:joinValues< >
  @LOCAL<Datatype>
  @SCOPE
    @MATCH @param#datatype:?eq<true>
    @CALL<Datatype><BuildDatatype> @table:put<type><(@param#name)>:put<name><(@param#name)>:put<props><(@param#props)>
  @END
  @LOCAL<Constructor>
  @SCOPE
    @MATCH @param#props:size:!?eq<0>
    @LOCAL<Constructor> public @param#name(@local#Parameters) {
      @\  @local#Assignments
      @\}
  @END
  @LOCAL<Unsafe>
  @SCOPE
    @MATCH @param#props:filter<KeepUnsafe>:size:!?eq<0>
    @LOCAL<Unsafe> unsafe
  @END
  @CODE<CLASS> public @local#Unsafe struct @param#name {
    @\  @local#Fields
    @\  @local#Constructor
    @\  @local#Datatype
    @\}
  @RETURN @param#props
@END

