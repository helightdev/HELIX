@ANNOTATION<HELIX.StructureAttribute>
  @PRELUDE
    @CALL<PropsModel><DeriveFields> @this
    @LOCAL<Parameters> @local#PropsModel:mapValues<SelectParameter>:joinValues<, >
    @LOCAL<Assignments> @local#PropsModel:mapValues<SelectAssignment>:joinValues< >
    @SCOPE
      @MATCH @local#PropsModel:size:!?eq<0>
      @CODE<CLASS> @this:visibility @this:name(@local#Parameters) {
        @\  @local#Assignments
        @\}
    @END
    @LOCAL<EqualityProps> @local#PropsModel:filter<KeepEquatable>
    @LOCAL<Comparisons> @local#EqualityProps:mapValues<SelectEquality>:joinValues< && >
    @LOCAL<HashAdds> @local#EqualityProps:mapValues<SelectHashAdd>:joinValues< >
    @LOCAL<Unsafe>
    @SCOPE
      @MATCH @this:?equatableSelf
      @MATCH @local#EqualityProps:filter<KeepUnsafe>:size:!?eq<0>
      @LOCAL<Unsafe> unsafe
    @END
    @SCOPE
      @MATCH @this:?equatableSelf
      @MATCH @this:!?typedEqualsSelf
      @CODE<CLASS> public @local#Unsafe bool Equals(@this:type other) => @local#Comparisons:switch<(@local#Comparisons)><true>;
    @END
    @LOCAL<TypedEqualsCall> Equals(other)
    @SCOPE
      @MATCH @this:?equatableSelf
      @MATCH @this:?typedEqualsSelf
      @MATCH @this:!?ordinaryTypedEqualsSelf
      @LOCAL<TypedEqualsCall> ((global::System.IEquatable<@this:type>)this).Equals(other)
    @END
    @SCOPE
      @MATCH @this:?equatableSelf
      @MATCH @this:!?objectEquals
      @CODE<CLASS> public override bool Equals(object obj) => obj is @this:type other && @local#TypedEqualsCall;
    @END
    @SCOPE
      @MATCH @this:?equatableSelf
      @MATCH @this:!?hashCode
      @CODE<CLASS> public override @local#Unsafe int GetHashCode() {
        @\  var hashCode = new global::System.HashCode();
        @\  @local#HashAdds
        @\  return hashCode.ToHashCode();
        @\}
    @END
    @SCOPE
      @MATCH @attr#datatype:?eq<true>
      @CALL<DatatypeCode><BuildDatatype> @table:put<type><(@this:type)>:put<name><(@this:name)>:put<props><(@local#PropsModel)>
      @CODE<CLASS> @local#DatatypeCode
    @END
  @END
@END

@ANNOTATION<HELIX.HookAttribute>
  @PRELUDE
    @LOCAL<Name> @attr#target:unwrap
    @SCOPE
      @MATCH @local#Name:eq<null>
      @ASSERT @target:name:matches<^On.*>
      @LOCAL<IsImplicit> true
      @Local<Name> $@target:name:replaceFirst<^On><>
    @END

    @SCOPE
      @MATCH @arg#0:!?exists
      @MIXIN<(@local#Name)><(@attr#order)> @target:name();
      @RETURN
    @END

    @RESOLVE_MIXIN<Delegate> @local#Name
    @ASSERT @local#Delegate:!?eq<null>
    @MIXIN<(@local#Name)><(@attr#order)> @target:name(@local#Delegate:wire<(@target)>);
  @END
@END

@ANNOTATION<HELIX.MixinUsingAttribute>
  @USING @attr#statement:unwrap;
@END


