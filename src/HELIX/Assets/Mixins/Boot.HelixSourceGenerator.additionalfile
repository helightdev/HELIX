//%pragma<DISASSEMBLE>
%pragma<PROFILE>
%vm<PROFILE>
//%vm<DEBUG>
%backend<Unity>
---

derivation mixin HELIX.Boot.NamedArgAttribute {
  prelude expression {
    local Named @= param#symbol:attributeOf<HELIX.Boot.NamedArgAttribute>;
    when($Named:exists) {
      local Configuration @> datatype.GetProperty("{{param#value#name}}").Modifiers.Add(NamedArgModifier.Instance);
      return(param#value:put(<configuration>, $Configuration))
    }
    return(param#value)
  }
}

mixin HELIX.Boot.CommandAttribute {
  prelude expression {
    local StructName @> {{target:name}}_Args
    local StructHandle @= target:DeriveParameters;
    EmitGeneratedStructure($StructName, $StructHandle, true);
  }
  expression {
    using @> HELIX.Boot;
    local TargetName @= target:name;
    local StructName @> {{$TargetName}}_Args
    local StructHandle @= inline(DeriveParameters, target);
    local InvokeArguments @= $StructHandle:map(func => <[$0#value#modifier] args.[$0#value#name]>):join<, >;
    local InvokeLambda @> args => {{$TargetName}}({{$InvokeArguments}})
    local CommandName @= attr#name:unwrap;
    local CmdName @= $CommandName:csharpLiteral;
    when($CommandName:eq(null)) {
      $CmdName @> "{{$TargetName}}"
    }
    local Description @= attr#description:csharpLiteral;
    local Parent @= attr#parent:csharpLiteral;
    local Bridge @> CommandBridge<{{$StructName}}>.Create({{$StructName}}.Datatype, {{$InvokeLambda}}, {{$CmdName}}, {{$Description}}, {{$Parent}})
    inject(<$LoadManagedLate>, 0) @> context.PublishBind(typeof(HELIX.UI.Console.Command), null, {{$Bridge}});
  }
}

mixin HELIX.Boot.RegisterCommandAttribute {
  prelude expression {
    inject(<$ConfigureManaged>, -1) @> registration.Publication(typeof(HELIX.UI.Console.Command), null, true);
    inject(<$LoadManagedLate>, 1) @> context.PublishBind(typeof(HELIX.UI.Console.Command), null, {{target:name}});
  }
}

mixin HELIX.Boot.RegisterOptionAttribute {
  prelude expression {
    when(attr#path:exists) {
      inject(<$Init>, -1) @> {{target:name}}.SetInferredPath({{attr#path}});
      inject(<$ConfigureManaged>, -1) @> registration.Publication(typeof({{target:type:unwrap}}), {{attr#path}}, true);
      inject(<$LoadManagedLate>, 1) @> context.PublishBind(typeof({{target:type:unwrap}}), {{attr#path}}, {{target:name}});
      return
    }
    {
      inject(<$Init>, -1) @> {{target:name}}.SetInferredName("{{target:name}}");
      inject(<$ConfigureManaged>, -1) @> registration.Publication(typeof(HELIX.Boot.Option), null, true);
      inject(<$LoadManagedLate>, 1) @> context.PublishBind(typeof(HELIX.Boot.Option), null, {{target:name}})
      return
    }
  }
}

mixin DefaultNamespace.TextMixin {}
