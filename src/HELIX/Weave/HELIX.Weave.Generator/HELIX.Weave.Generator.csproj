<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>HelixWeaveGenerator</AssemblyName>
    <RootNamespace>Helix.Weave</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!--
    The weave host plus this project's lowered mixins, compiled into one analyzer assembly.
    The host is included as source rather than referenced because Unity loads a single DLL.
  -->
  <ItemGroup>
    <Compile Include="../../../Weave/Helix.Weave/**/*.cs"
             Exclude="../../../Weave/Helix.Weave/bin/**;../../../Weave/Helix.Weave/obj/**" />
    <Compile Include="gen/**/*.cs" />
  </ItemGroup>

  <!-- Opt-in: `dotnet build -p:Lower=true` regenerates gen/ from the mixin project. -->
  <Target Name="LowerMixins" BeforeTargets="BeforeCompile" Condition="'$(Lower)' == 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../../../Weave/Helix.Weave.Lower&quot; -- &quot;$(MSBuildThisFileDirectory)../HELIX.Weave.Mixins&quot; &quot;$(MSBuildThisFileDirectory)gen&quot;"
          StandardOutputImportance="low" />
  </Target>
</Project>
