<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>HELIX.Weave</RootNamespace>
    <!--
      Authoring only. These sources are read and relocated by the lowering pass; the assembly
      itself is never shipped. They live beside Assets/ rather than inside it so Unity does not
      compile them into the game.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" ExcludeAssets="runtime" />
    <ProjectReference Include="../../../Weave/Helix.Weave/Helix.Weave.csproj" />
  </ItemGroup>
</Project>
