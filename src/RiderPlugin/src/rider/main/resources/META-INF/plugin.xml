<idea-plugin require-restart="true">
  <id>dev.helight.helix</id>
  <name>HELIX</name>
  <version>0.0.1</version>
  <vendor url="https://helight.dev">Helight Dev</vendor>
  <idea-version since-build="262" />
  <dependencies>
    <module name="intellij.rd.client" />
    <module name="intellij.rider.languages" />
    <module name="intellij.rider.rdclient.dotnet" />
    <module name="intellij.platform.smRunner" />
    <module name="intellij.platform.testRunner" />
    <module name="intellij.platform.testIntegration" />
  </dependencies>
  <depends>com.intellij.modules.rider</depends>
  <depends>com.intellij.resharper.unity</depends>
  <depends>org.jetbrains.plugins.yaml</depends>

  <description>
<![CDATA[
<p>Readable, inspectable Unity YAML support for Rider.</p>
]]>
  </description>

  <extensionPoints>
    <extensionPoint name="workspaceEntryProvider"
                    interface="dev.helight.helix.workspace.WorkspaceEntryProvider"
                    dynamic="true" />
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Hix Toolchain" displayType="BALLOON" />
    <serviceViewContributor implementation="dev.helight.helix.cli.UnityCliServiceViewContributor" />
    <statusBarWidgetFactory id="dev.helight.helix.UnityCliStatus" implementation="dev.helight.helix.cli.UnityCliStatusBarWidgetFactory" />
    <fileType name="Hix"
              implementationClass="dev.helight.helix.hix.HixFileType"
              fieldName="INSTANCE"
              language="Hix"
              extensions="hix"
              patterns="*.HelixSourceGenerator.additionalfile" />
    <fileType name="Hal" implementationClass="dev.helight.helix.hal.HalFileType"
              fieldName="INSTANCE" language="Hal" extensions="hal" />
    <lang.parserDefinition language="Hal" implementationClass="dev.helight.helix.hal.HalParserDefinition" />
    <lang.syntaxHighlighterFactory language="Hal" implementationClass="dev.helight.helix.hal.HalSyntaxHighlighterFactory" />
    <completion.contributor language="Hal" implementationClass="dev.helight.helix.hal.HalCompletionContributor" />
    <annotator language="Hal" implementationClass="dev.helight.helix.hal.HalAnnotator" />
    <lang.braceMatcher language="Hal" implementationClass="dev.helight.helix.hal.HalBraceMatcher" />
    <quoteHandler fileType="Hal" className="dev.helight.helix.hal.HalQuoteHandler" />
    <typedHandler implementation="dev.helight.helix.hal.HalQuoteTypedHandler" />
    <preFormatProcessor implementation="dev.helight.helix.hal.HalPreFormatProcessor" />
    <lang.formatter language="Hal" implementationClass="dev.helight.helix.hal.HalFormattingModelBuilder" />
    <enterBetweenBracesDelegate language="Hix" implementationClass="dev.helight.helix.hix.HixBracketEnterDelegate" />
    <enterBetweenBracesDelegate language="Hal" implementationClass="dev.helight.helix.hix.HixBracketEnterDelegate" />
    <backspaceHandlerDelegate implementation="dev.helight.helix.hix.HixBracketBackspaceDelegate" />
    <lineIndentProvider implementation="dev.helight.helix.hal.HalLineIndentProvider" />
    <langCodeStyleSettingsProvider implementation="dev.helight.helix.hal.HalCodeStyleSettingsProvider" />
    <lang.parserDefinition language="Hix"
                           implementationClass="dev.helight.helix.hix.HixParserDefinition" />
    <lang.syntaxHighlighterFactory language="Hix"
                                   implementationClass="dev.helight.helix.hix.HixSyntaxHighlighterFactory" />
    <colorSettingsPage implementation="dev.helight.helix.hix.HixColorSettingsPage" />
    <langCodeStyleSettingsProvider implementation="dev.helight.helix.hix.HixCodeStyleSettingsProvider" />
    <completion.contributor language="Hix"
                            implementationClass="dev.helight.helix.hix.HixMetadataCompletionContributor" />
    <completion.contributor language="Hix"
                            implementationClass="dev.helight.helix.hix.HixPatternCompletionContributor" />
    <completion.contributor language="Hix"
                            implementationClass="dev.helight.helix.hix.HixExpressionCompletionContributor" />
    <annotator language="Hix"
               implementationClass="dev.helight.helix.hix.HixAnnotator" />
    <codeInsight.parameterInfo language="Hix" implementationClass="dev.helight.helix.hix.HixParameterInfoHandler" />
    <codeInsight.parameterInfo language="Hal" implementationClass="dev.helight.helix.hal.HalParameterInfoHandler" />
    <codeInsight.parameterNameHints language="Hix" implementationClass="dev.helight.helix.hix.HixParameterHintsProvider" />
    <codeInsight.parameterNameHints language="Hal" implementationClass="dev.helight.helix.hal.HalParameterHintsProvider" />
    <codeInsight.declarativeInlayProvider language="Hix" providerId="hix.inferred.types"
        group="TYPES_GROUP" bundle="messages.HelixMessagesBundle" nameKey="hix.inlay.types.name" descriptionKey="hix.inlay.types.description"
        implementationClass="dev.helight.helix.hix.HixInlayHintsProvider">
      <option optionId="inferredTypes" nameKey="hix.inlay.locals.name" descriptionBundleKey="hix.inlay.locals.description" enabledByDefault="true" />
      <option optionId="conversions" nameKey="hix.inlay.conversions.name" descriptionBundleKey="hix.inlay.conversions.description" enabledByDefault="true" />
    </codeInsight.declarativeInlayProvider>
    <codeInsight.declarativeInlayProvider language="Hal" providerId="hal.field.types"
        group="TYPES_GROUP" bundle="messages.HelixMessagesBundle" nameKey="hal.inlay.types.name" descriptionKey="hal.inlay.types.description"
        isEnabledByDefault="false" implementationClass="dev.helight.helix.hal.HalInlayHintsProvider" />
    <lang.documentationProvider language="Hix"
                                implementationClass="dev.helight.helix.hix.HixDocumentationProvider" />
    <lang.findUsagesProvider language="Hix"
                             implementationClass="dev.helight.helix.hix.HixFindUsagesProvider" />
    <lang.braceMatcher language="Hix"
                       implementationClass="dev.helight.helix.hix.HixBraceMatcher" />
    <quoteHandler fileType="Hix" className="dev.helight.helix.hix.HixQuoteHandler" />
    <preFormatProcessor implementation="dev.helight.helix.hix.HixPreFormatProcessor" />
    <lang.formatter language="Hix" implementationClass="dev.helight.helix.hix.HixFormattingModelBuilder" />
    <lineIndentProvider implementation="dev.helight.helix.hix.HixLineIndentProvider" />
    <typedHandler implementation="dev.helight.helix.hix.HixDelimiterTypedHandler" />
    <configurationType implementation="dev.helight.helix.hix.run.HixRunConfigurationType" />
    <runConfigurationProducer implementation="dev.helight.helix.hix.run.HixApplicationRunConfigurationProducer" />
    <runConfigurationProducer implementation="dev.helight.helix.hix.run.HixTestRunConfigurationProducer" />
    <newProjectWizard.generator implementation="dev.helight.helix.hix.project.HixProjectWizard" />
    <projectOpenProcessor implementation="dev.helight.helix.hix.project.HixProjectOpenProcessor"
                          order="first" />
    <projectSettings service="dev.helight.helix.workspace.WorkspaceSettings"/>
    <projectViewPane implementation="dev.helight.helix.workspace.UnityWorkspaceProjectViewPane"
                     id="HelixUnityWorkspace"
                     order="after UnityExplorer, before SolutionExplorer" />
    <projectConfigurable id="dev.helight.helix.workspace"
                         instance="dev.helight.helix.workspace.WorkspaceSettingsConfigurable"
                         bundle="messages.HelixMessagesBundle"
                         key="workspace.settings.name" />
  </extensions>

  <extensions defaultExtensionNs="dev.helight.helix">
    <workspaceEntryProvider implementation="dev.helight.helix.workspace.DirectoryWorkspaceEntryProvider" />
    <workspaceEntryProvider implementation="dev.helight.helix.workspace.UnityPackagesWorkspaceEntryProvider" />
  </extensions>

  <actions resource-bundle="messages.HelixMessagesBundle">
    <action id="Helix.RefreshUnityWorkspace"
            class="dev.helight.helix.workspace.UnityWorkspaceRefreshAction"
            icon="dev.helight.helix.HelixIcons.Refresh" />
  </actions>

    <resource-bundle>messages.HelixMessagesBundle</resource-bundle>
</idea-plugin>
