{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HELIX Mixin Expression",
  "scopeName": "source.helix-mixin",
  "fileTypes": ["hxmixin"],
  "patterns": [
    { "include": "#directive" },
    { "include": "#escaped-at" },
    { "include": "#parenthesized-expression" },
    { "include": "#expression" },
    { "include": "#target" },
    { "include": "#number" }
  ],
  "repository": {
    "directive": {
      "begin": "^(\\s*)(@[A-Z][A-Za-z_]*)",
      "beginCaptures": {
        "2": { "name": "keyword.control.directive.helix-mixin" }
      },
      "end": "(?=\\s|$)",
      "name": "meta.directive.helix-mixin",
      "patterns": [
        { "include": "#argument" }
      ]
    },
    "escaped-at": {
      "match": "@@",
      "name": "constant.character.escape.helix-mixin"
    },
    "parenthesized-expression": {
      "begin": "(@)(\\()([A-Za-z0-9_]+)",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.expression.begin.helix-mixin" },
        "2": { "name": "entity.name.tag.expression.begin.helix-mixin" },
        "3": { "name": "constant.language.mixin-reference.helix-mixin" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "entity.name.tag.expression.end.helix-mixin" }
      },
      "name": "meta.expression.mixin-reference.helix-mixin",
      "patterns": [
        { "include": "#expression-body" }
      ]
    },
    "expression": {
      "begin": "@[A-Za-z0-9_]+",
      "beginCaptures": {
        "0": { "name": "constant.language.mixin-reference.helix-mixin" }
      },
      "end": "(?=[^A-Za-z0-9_#:<]|$)",
      "name": "meta.expression.mixin-reference.helix-mixin",
      "patterns": [
        { "include": "#expression-body" }
      ]
    },
    "expression-body": {
      "patterns": [
        { "include": "#escaped-at" },
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#member" },
        { "include": "#predicate" },
        { "include": "#logical-operation" },
        { "include": "#transformation" },
        { "include": "#generic-predicate" },
        { "include": "#generic-transformation" },
        { "include": "#argument" },
        { "include": "#target" },
        { "include": "#number" }
      ]
    },
    "member": {
      "match": "#+[A-Za-z0-9_]+",
      "name": "entity.name.section.member-path.helix-mixin"
    },
    "predicate": {
      "match": ":!?\\??(?:eq|exists|is|has|isSelf|ref|in|out|inout|argument|static|async|public|exposed|top|concrete|partial|generic|struct|class|matches|signature|wireable)\\b",
      "name": "support.function.predicate.helix-mixin"
    },
    "logical-operation": {
      "match": ":(?:and|or)\\b",
      "name": "keyword.operator.logical.helix-mixin"
    },
    "transformation": {
      "match": ":(?:name|type|fullName|unwrap|replace|replaceFirst|switch|put|remove|push|pop|size|floatTime|wire|path)\\b",
      "name": "entity.name.function.transform.helix-mixin"
    },
    "generic-predicate": {
      "match": ":!?\\?[A-Za-z0-9_]+",
      "name": "support.function.predicate.helix-mixin"
    },
    "generic-transformation": {
      "match": ":[A-Za-z0-9_]+",
      "name": "entity.name.function.transform.helix-mixin"
    },
    "argument": {
      "begin": "<",
      "beginCaptures": {
        "0": { "name": "entity.name.tag.argument.begin.helix-mixin" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "entity.name.tag.argument.end.helix-mixin" }
      },
      "name": "entity.name.tag.argument.helix-mixin",
      "patterns": [
        { "include": "#escaped-at" },
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#argument" },
        { "include": "#target" },
        { "include": "#number" }
      ]
    },
    "target": {
      "patterns": [
        {
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
          "name": "entity.name.function.target.helix-mixin"
        },
        {
          "match": "\\b(?:CLASS|FILE|IMPLEMENTS|ANNOTATION|TARGET|STATE|BUFFER|AST)\\b",
          "name": "constant.language.target.helix-mixin"
        }
      ]
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?f?\\b",
      "name": "constant.numeric.helix-mixin"
    }
  }
}
