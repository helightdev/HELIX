{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HELIX Mixin Expression",
  "scopeName": "source.helix-mixin",
  "fileTypes": ["hxmixin"],
  "patterns": [
    {
      "begin": "^",
      "end": "$",
      "patterns": [
        { "include": "#directive" },
        { "include": "#escaped-at" },
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#directive-argument" }
      ]
    }
  ],
  "repository": {
    "directive": {
      "begin": "^( *)(@[A-Z][a-zA-Z_]+)(?=(?:<[^<>\\s]*>)*(?:\\s|$))",
      "beginCaptures": {
        "2": { "name": "keyword.control.directive.helix-mixin" }
      },
      "end": "(?=\\s|$)",
      "name": "meta.directive.helix-mixin",
      "patterns": [
        { "include": "#directive-argument" }
      ]
    },
    "escaped-at": {
      "match": "@@",
      "name": "constant.character.escape.helix-mixin"
    },
    "parenthesized-expression": {
      "patterns": [
        {
          "begin": "(@\\()((?:true|false|null|table))(?=(?:#[a-zA-Z0-9_]+|(?:(?:(?::!\\?|:\\?)[a-zA-Z]+|:[a-z]+)(?:<[^<>\\s]*>)*))*\\)(?=\\s|[,;(){}\\[\\]]|$))",
          "beginCaptures": {
            "1": { "name": "variable.root.helix-mixin" },
            "2": { "name": "variable.root.helix-mixin" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "variable.root.helix-mixin" }
          },
          "name": "meta.expression.parenthesized.helix-mixin",
          "patterns": [
            { "include": "#expression-body" }
          ]
        },
        {
          "begin": "(@\\()([a-z][a-zA-Z_]+)(?=(?:#[a-zA-Z0-9_]+|(?:(?:(?::!\\?|:\\?)[a-zA-Z]+|:[a-z]+)(?:<[^<>\\s]*>)*))*\\)(?=\\s|[,;(){}\\[\\]]|$))",
          "beginCaptures": {
            "1": { "name": "variable.root.helix-mixin" },
            "2": { "name": "variable.root.helix-mixin" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "variable.root.helix-mixin" }
          },
          "name": "meta.expression.parenthesized.helix-mixin",
          "patterns": [
            { "include": "#expression-body" }
          ]
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "begin": "(@(?:true|false|null|table))(?=(?:#[a-zA-Z0-9_]+|(?:(?:(?::!\\?|:\\?)[a-zA-Z]+|:[a-z]+)(?:<[^<>\\s]*>)*))*(?=\\s|[,;(){}\\[\\]]|$))",
          "beginCaptures": {
            "1": { "name": "variable.root.helix-mixin" }
          },
          "end": "(?=\\s|[,;(){}\\[\\]]|$)",
          "name": "meta.expression.helix-mixin",
          "patterns": [
            { "include": "#expression-body" }
          ]
        },
        {
          "begin": "(@[a-z][a-zA-Z_]+)(?=(?:#[a-zA-Z0-9_]+|(?:(?:(?::!\\?|:\\?)[a-zA-Z]+|:[a-z]+)(?:<[^<>\\s]*>)*))*(?=\\s|[,;(){}\\[\\]]|$))",
          "beginCaptures": {
            "1": { "name": "variable.root.helix-mixin" }
          },
          "end": "(?=\\s|[,;(){}\\[\\]]|$)",
          "name": "meta.expression.helix-mixin",
          "patterns": [
            { "include": "#expression-body" }
          ]
        }
      ]
    },
    "expression-body": {
      "patterns": [
        { "include": "#escaped-at" },
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#member" },
        { "include": "#predicate" },
        { "include": "#logical-operation" },
        { "include": "#transformation" },
        { "include": "#generic-predicate" },
        { "include": "#generic-transformation" },
        { "include": "#angle-argument" },
        { "include": "#target" },
        { "include": "#number" }
      ]
    },
    "member": {
      "match": "(#+)([A-Za-z0-9_]+)",
      "name": "entity.name.member-path.helix-mixin"
    },
    "predicate": {
      "match": ":!?\\??(?:eq|exists|is|has|isSelf|ref|in|out|inout|argument|static|async|public|exposed|top|concrete|partial|generic|struct|class|matches|signature|wireable)\\b",
      "name": "support.function.predicate.helix-mixin"
    },
    "logical-operation": {
      "match": ":(?:and|or)\\b",
      "name": "keyword.operator.logical.helix-mixin"
    },
    "transformation": {
      "match": ":(?:name|type|fullName|unwrap|replace|replaceFirst|switch|put|remove|push|pop|size|floatTime|wire|path)\\b",
      "name": "entity.name.function.transform.helix-mixin"
    },
    "generic-predicate": {
      "match": ":!?\\?[a-zA-Z]+\\b",
      "name": "support.function.predicate.helix-mixin"
    },
    "generic-transformation": {
      "match": ":[a-z]+\\b",
      "name": "entity.name.function.transform.helix-mixin"
    },
    "angle-argument": {
      "begin": "<",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.argument.begin.helix-mixin" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.argument.end.helix-mixin" }
      },
      "name": "markup.inline.raw.argument.helix-mixin",
      "patterns": [
        { "include": "#escaped-at" },
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#angle-argument" }
      ]
    },
    "directive-argument": {
      "begin": "<",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.argument.begin.helix-mixin" }
      },
      "end": ">",
      "endCaptures": {
        "0": { "name": "punctuation.definition.argument.end.helix-mixin" }
      },
      "name": "markup.inline.raw.argument.helix-mixin",
      "patterns": [
        { "include": "#parenthesized-expression" },
        { "include": "#expression" },
        { "include": "#directive-argument" }
      ]
    },
    "target": {
      "patterns": [
        {
          "match": "\\$(?:[A-Za-z_][A-Za-z0-9_]*)",
          "name": "entity.name.function.target.helix-mixin"
        },
        {
          "match": "\\b(CLASS|FILE|IMPLEMENTS|ANNOTATION|TARGET|STATE|BUFFER|AST)\\b",
          "name": "constant.language.target.helix-mixin"
        }
      ]
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])[-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?f?\\b",
      "name": "constant.numeric.helix-mixin"
    }
  }
}
